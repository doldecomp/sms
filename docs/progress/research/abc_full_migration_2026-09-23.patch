 // and owner are unknown.
+static inline JGeometry::TVec3<f32> TongueDiff(const JGeometry::TVec3<f32>& a,
+                                             const JGeometry::TVec3<f32>& b)
+{
+	JGeometry::TVec3<f32> d(a);
+	d -= b;
+	return d;
+}
+
+static inline JGeometry::TVec3<f32> TongueScaledDiff(const JGeometry::TVec3<f32>& a,
+                                                   const JGeometry::TVec3<f32>& b, f32 k)
+{
+	return TongueDiff(a, b) * k;
+}
