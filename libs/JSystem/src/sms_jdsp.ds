; SMS jdsp

; DSP ROM entry points
ROM_BOOT: equ 0x8000
ROM_SWITCH_TASK: equ 0x80b5

; Hardware registers
DMA_CONTROL: equ 0xffc9
DMA_BYTE_LENGTH: equ 0xffcb
DMA_DSP_WORD_ADDRESS: equ 0xffcd
DMA_MAIN_ADDRESS_H: equ 0xffce
DMA_MAIN_ADDRESS_L: equ 0xffcf
ACCEL_FORMAT: equ 0xffd1
ACCEL_RAW_DATA: equ 0xffd3
ACCEL_START_ADDRESS_H: equ 0xffd4
ACCEL_START_ADDRESS_L: equ 0xffd5
ACCEL_END_ADDRESS_H: equ 0xffd6
ACCEL_END_ADDRESS_L: equ 0xffd7
ACCEL_CURRENT_ADDRESS_H: equ 0xffd8
ACCEL_CURRENT_ADDRESS_L: equ 0xffd9
CPU_INTERRUPT_REQUEST: equ 0xfffb
DSP_TO_CPU_MAILBOX_H: equ 0xfffc
DSP_TO_CPU_MAILBOX_L: equ 0xfffd
CPU_TO_DSP_MAILBOX_H: equ 0xfffe
CPU_TO_DSP_MAILBOX_L: equ 0xffff

; DSP data RAM (word addresses)
RESAMPLING_COEFFICIENTS: equ 0x0000
WAVEFORM_PATTERN_0: equ 0x0100
WAVEFORM_PATTERN_1: equ 0x0140
WAVEFORM_PATTERN_2: equ 0x0180
WAVEFORM_PATTERN_2_HISTORY: equ 0x01be
WAVEFORM_PATTERN_3: equ 0x01c0
WAVEFORM_PATTERN_3_HISTORY: equ 0x01fe
POSITIONAL_SINE_TABLE: equ 0x0200
COMMAND_QUEUE: equ 0x0280
RESAMPLER_PHASE_SCRATCH: equ 0x02b0
AFC_COEFFICIENTS: equ 0x0300
RENDER_BLOCKS_REMAINING: equ 0x0341
RENDER_VOICE_COUNT: equ 0x0342
COMMAND_DISPATCH_OFFSET: equ 0x0343
COMMAND_HEADER_LOW_BYTE: equ 0x0344
COMMAND_EXTRA_DATA: equ 0x0345
UTILITY_ARGUMENTS: equ 0x0346
DATA_0349: equ 0x0349
CURRENT_VOICE_ADDRESS_H: equ 0x034c
CURRENT_VOICE_ADDRESS_L: equ 0x034d
CPU_RELEASE_GATE: equ 0x034e
COMMAND_QUEUE_WRITE_POINTER: equ 0x0350
COMMAND_QUEUE_READ_POINTER: equ 0x0351
PENDING_COMMAND_COUNT: equ 0x0352
CURRENT_VOICE_INDEX: equ 0x0354
CURRENT_BLOCK_INDEX: equ 0x0355
COMMAND_HEADER_H: equ 0x0356
COMMAND_HEADER_L: equ 0x0357
COMMAND_ARGUMENTS: equ 0x0358
DATA_0360: equ 0x0360
DATA_0361: equ 0x0361
DATA_0362: equ 0x0362
AFC_RESIDUAL_SCRATCH: equ 0x0370
VOICE_TABLE_ADDRESS_H: equ 0x0380
VOICE_TABLE_ADDRESS_L: equ 0x0381
RENDER_TABLES_ADDRESS_H: equ 0x0382
AFC_TABLE_ADDRESS_H: equ 0x0384
EFFECTS_TABLE_ADDRESS_H: equ 0x0386
OUTPUT_LEFT_ADDRESS_H: equ 0x0388
OUTPUT_RIGHT_ADDRESS_H: equ 0x038a
MASTER_GAIN: equ 0x038e
FILTERED_VOICE_POINTER: equ 0x038f
EFFECTS_LINE_FLAGS: equ 0x0390
EFFECTS_LINE_RING_LENGTH: equ 0x0391
EFFECTS_LINE_ADDRESS_L: equ 0x0393
EFFECTS_LINE_SEND_0_DESTINATION: equ 0x0394
EFFECTS_LINE_SEND_0_GAIN: equ 0x0395
EFFECTS_LINE_SEND_1_DESTINATION: equ 0x0396
EFFECTS_LINE_SEND_1_GAIN: equ 0x0397
EFFECTS_LINE_FIR_COEFFICIENTS: equ 0x0398
EFFECTS_RING_INDEX_POINTER: equ 0x03a0
EFFECTS_WORK_BUFFER_POINTER: equ 0x03a1
EFFECTS_PARAMETERS_POINTER: equ 0x03a2
DATA_03A3: equ 0x03a3
EFFECTS_RING_INDICES: equ 0x03a4
EFFECTS_PARAMETERS: equ 0x03a8
FILTER_COEFFICIENT_SCRATCH: equ 0x03e8
MODULATED_DELAY_WRITE_OFFSET: equ 0x03f0
MODULATED_DELAY_READ_OFFSET: equ 0x03f1
MODULATED_DELAY_DIRECTION: equ 0x03f2
MODULATED_DELAY_THRESHOLD_0: equ 0x03f3
MODULATED_DELAY_THRESHOLD_1: equ 0x03f4
MODULATED_DELAY_READ_STEP: equ 0x03f5
MODULATED_DELAY_READ_FRACTION: equ 0x03f6
MODULATED_DELAY_STEP_DELTA: equ 0x03f7
SAVED_VOICE_CONSTANT_SAMPLE: equ 0x03f8
TASK_CONTINUATION: equ 0x03f9
INTERRUPT_SAVED_AX0_H: equ 0x03fa
INTERRUPT_SAVED_AR0: equ 0x03fb
INTERRUPT_SAVED_WR0: equ 0x03fc
INTERRUPT_SAVED_ACC0_H: equ 0x03fd
INTERRUPT_SAVED_ACC0_M: equ 0x03fe
INTERRUPT_SAVED_ACC0_L: equ 0x03ff
VOICE_ENABLED: equ 0x0400
VOICE_DONE: equ 0x0401
VOICE_PITCH: equ 0x0402
VOICE_RESET: equ 0x0404
VOICE_END_REACHED: equ 0x0405
VOICE_USE_CONSTANT_SAMPLE: equ 0x0406
VOICE_SAVED_SAMPLE_COUNT: equ 0x0407
VOICE_SEND_0_DESTINATION: equ 0x0408
VOICE_SEND_0_GAIN_CURRENT: equ 0x040a
VOICE_POSITION: equ 0x0428
VOICE_EFFECTS_GAIN: equ 0x0429
VOICE_POSITIONAL_GAIN_CURRENT: equ 0x042a
VOICE_POSITIONAL_GAIN_TARGET: equ 0x042b
VOICE_USE_POSITIONAL_MIXER: equ 0x042c
DATA_042D: equ 0x042d
VOICE_PHASE_FRACTION: equ 0x0430
VOICE_AFC_DECODED_SAMPLE_INDEX: equ 0x0431
VOICE_AFC_DECODED_SAMPLE_COUNT: equ 0x0432
VOICE_CONSTANT_SAMPLE: equ 0x0433
VOICE_SOURCE_POSITION_H: equ 0x0434
VOICE_SOURCE_POSITION_L: equ 0x0435
DATA_0436: equ 0x0436
DATA_0437: equ 0x0437
VOICE_ARAM_ADDRESS_H: equ 0x0438
VOICE_ARAM_ADDRESS_L: equ 0x0439
VOICE_REMAINING_LENGTH_H: equ 0x043a
VOICE_REMAINING_LENGTH_L: equ 0x043b
VOICE_RESAMPLING_HISTORY: equ 0x043c
VOICE_FIR_HISTORY: equ 0x0440
VOICE_RECURSIVE_HISTORY: equ 0x0454
VOICE_AFC_DECODED_SAMPLES: equ 0x0458
VOICE_AFC_HISTORY_OLDER: equ 0x0466
VOICE_AFC_HISTORY_NEWER: equ 0x0467
VOICE_SEND_DELAY_HISTORY_END: equ 0x0477
VOICE_DISTANCE_HISTORY_Y: equ 0x0478
VOICE_DISTANCE_HISTORY_X: equ 0x0479
VOICE_SOURCE_TYPE: equ 0x0480
VOICE_LOOP_ENABLED: equ 0x0481
VOICE_LOOP_HISTORY_NEWER: equ 0x0482
VOICE_LOOP_HISTORY_OLDER: equ 0x0483
VOICE_FILTER_MODE: equ 0x0484
VOICE_STOP_REQUESTED: equ 0x0485
VOICE_LOOP_ADDRESS_H: equ 0x0488
VOICE_LOOP_ADDRESS_L: equ 0x0489
VOICE_LOOP_END_POSITION_H: equ 0x048a
VOICE_LOOP_END_POSITION_L: equ 0x048b
VOICE_BASE_ADDRESS_H: equ 0x048c
VOICE_BASE_ADDRESS_L: equ 0x048d
VOICE_FIR_COEFFICIENTS: equ 0x0490
VOICE_RECURSIVE_COEFFICIENTS: equ 0x04a4
VOICE_RECURSIVE_COEFFICIENT_LAST: equ 0x04a7
VOICE_DISTANCE_COEFFICIENT: equ 0x04a8
ACTIVE_VOICE_MASK_0: equ 0x04fc
ACTIVE_VOICE_MASK_1: equ 0x04fd
ACTIVE_VOICE_MASK_2: equ 0x04fe
ACTIVE_VOICE_MASK_3: equ 0x04ff
VOICE_SAMPLE_BUFFER: equ 0x0520
RAW_SAMPLE_BUFFER: equ 0x0580
BUS_AUX_CENTER: equ 0x09a0
BUS_MODULATED_DELAY: equ 0x0a00
MODULATED_DELAY_RING: equ 0x0a60
SHARED_SAMPLE_GAIN_SCRATCH: equ 0x0b00
POSITIONAL_SAVED_AR1: equ 0x0b24
POSITIONAL_SAVED_AR2: equ 0x0b25
POSITIONAL_SAVED_AR3: equ 0x0b26
BUS_REAR_LEFT_FX: equ 0x0c00
BUS_REAR_RIGHT_FX: equ 0x0c50
BUS_REAR_RIGHT_FX_SECOND_HALF: equ 0x0c78
BUS_REAR_RIGHT: equ 0x0ca0
BUS_REAR_RIGHT_SECOND_HALF: equ 0x0cc8
BUS_FRONT_LEFT: equ 0x0d00
BUS_FRONT_LEFT_SECOND_HALF: equ 0x0d28
BUS_FRONT_RIGHT: equ 0x0d60
BUS_FRONT_RIGHT_SECOND_HALF: equ 0x0d88
BUS_EFFECTS_0: equ 0x0dc0
BUS_FRONT_LEFT_FX: equ 0x0e80
BUS_FRONT_LEFT_FX_SECOND_HALF: equ 0x0ea8
BUS_FRONT_RIGHT_FX: equ 0x0ee0
BUS_FRONT_RIGHT_FX_SECOND_HALF: equ 0x0f08
BUS_REAR_LEFT: equ 0x0f40
BUS_AUX_RIGHT_SUBTRACT: equ 0x0fa0

VOICE_BLOCK: equ VOICE_ENABLED

; Paged voice operands: LRS/SRS encode a signed 8-bit address, with CR=4.
VOICE_PAGE: equ 0x0400
VOICE_DONE_SHORT: equ VOICE_DONE - VOICE_PAGE
VOICE_PITCH_SHORT: equ VOICE_PITCH - VOICE_PAGE
VOICE_RESET_SHORT: equ VOICE_RESET - VOICE_PAGE
VOICE_END_REACHED_SHORT: equ VOICE_END_REACHED - VOICE_PAGE
VOICE_PHASE_FRACTION_SHORT: equ VOICE_PHASE_FRACTION - VOICE_PAGE
VOICE_AFC_DECODED_SAMPLE_INDEX_SHORT: equ VOICE_AFC_DECODED_SAMPLE_INDEX - VOICE_PAGE
VOICE_AFC_DECODED_SAMPLE_COUNT_SHORT: equ VOICE_AFC_DECODED_SAMPLE_COUNT - VOICE_PAGE
VOICE_SOURCE_POSITION_H_SHORT: equ VOICE_SOURCE_POSITION_H - VOICE_PAGE
VOICE_SOURCE_POSITION_L_SHORT: equ VOICE_SOURCE_POSITION_L - VOICE_PAGE
DATA_0436_SHORT: equ DATA_0436 - VOICE_PAGE
DATA_0437_SHORT: equ DATA_0437 - VOICE_PAGE
VOICE_ARAM_ADDRESS_H_SHORT: equ VOICE_ARAM_ADDRESS_H - VOICE_PAGE
VOICE_ARAM_ADDRESS_L_SHORT: equ VOICE_ARAM_ADDRESS_L - VOICE_PAGE
VOICE_REMAINING_LENGTH_H_SHORT: equ VOICE_REMAINING_LENGTH_H - VOICE_PAGE
VOICE_REMAINING_LENGTH_L_SHORT: equ VOICE_REMAINING_LENGTH_L - VOICE_PAGE
VOICE_AFC_HISTORY_OLDER_SHORT: equ VOICE_AFC_HISTORY_OLDER - VOICE_PAGE
VOICE_AFC_HISTORY_NEWER_SHORT: equ VOICE_AFC_HISTORY_NEWER - VOICE_PAGE
VOICE_SOURCE_TYPE_SHORT: equ VOICE_SOURCE_TYPE - VOICE_PAGE + 0xff00
VOICE_LOOP_ENABLED_SHORT: equ VOICE_LOOP_ENABLED - VOICE_PAGE + 0xff00
VOICE_LOOP_HISTORY_NEWER_SHORT: equ VOICE_LOOP_HISTORY_NEWER - VOICE_PAGE + 0xff00
VOICE_LOOP_HISTORY_OLDER_SHORT: equ VOICE_LOOP_HISTORY_OLDER - VOICE_PAGE + 0xff00
VOICE_LOOP_ADDRESS_H_SHORT: equ VOICE_LOOP_ADDRESS_H - VOICE_PAGE + 0xff00
VOICE_LOOP_ADDRESS_L_SHORT: equ VOICE_LOOP_ADDRESS_L - VOICE_PAGE + 0xff00
VOICE_LOOP_END_POSITION_H_SHORT: equ VOICE_LOOP_END_POSITION_H - VOICE_PAGE + 0xff00
VOICE_LOOP_END_POSITION_L_SHORT: equ VOICE_LOOP_END_POSITION_L - VOICE_PAGE + 0xff00
VOICE_BASE_ADDRESS_H_SHORT: equ VOICE_BASE_ADDRESS_H - VOICE_PAGE + 0xff00
VOICE_BASE_ADDRESS_L_SHORT: equ VOICE_BASE_ADDRESS_L - VOICE_PAGE + 0xff00


; 0000: Boot vector; all code addresses and DSP RAM addresses are 16-bit WORD addresses.
boot_vector:
	jmp         boot
	nop
	nop
	rti
	nop
	rti
	nop
	rti
	nop
	rti
	nop
	rti
	nop

; 000E: CPU interrupt vector -> mailbox receiver.
cpu_interrupt_vector:
	jmp         receive_cpu_interrupt

; 0010: Task resume vector.
resume_vector:
	jmp         resume_task

; 0012: Boot: initialize registers, clear 0x1000 DRAM words, send DCD10000 and F3551111.
boot:
	sbclr       #0x05
	call        initialize_registers
	clr         $ACC0
	lri         $AC1.M, #0x1000
	lri         $AR0, #0x0000
	loop        $AC1.M
	srri        @$AR0, $AC0.M
	call        initialize_command_queue
	lris        $AC0.M, #0x00
	call        send_task_mail
	lri         $AC0.M, #0x1111
	call        send_audio_mail
	lris        $AC0.M, #0x01
	sr          @CPU_RELEASE_GATE, $AC0.M
	sbset       #0x05

; 0029: Main command-queue polling loop.
command_loop:
	jmp         read_command_queue

; 002B: Decode command header; high byte selects command, low halfword is extra data.
dispatch_command:
	lr          $AC1.M, @COMMAND_HEADER_L
	sr          @COMMAND_EXTRA_DATA, $AC1.M
	lr          $AC0.M, @COMMAND_HEADER_H
	mrr         $AC1.M, $AC0.M
	andi        $AC1.M, #0x00ff
	sr          @COMMAND_HEADER_LOW_BYTE, $AC1.M
	lsr         $ACC0, #-7
	andi        $AC0.M, #0x007e
	sr          @COMMAND_DISPATCH_OFFSET, $AC0.M
	addi        $AC0.M, #command_dispatch_table
	mrr         $AR0, $AC0.M
	jmpr        $AR0

; 003F: Standard acknowledgement: DCD10004 interrupt, then F355 + command high halfword.
acknowledge_command:
	lri         $CR, #0x00ff
	lris        $AC0.M, #0x04
	call        send_task_mail
	lr          $AC0.M, @COMMAND_HEADER_H
	call        send_audio_mail
	jmp         command_loop

; 004A: Resume task, restore working modes, send DCD10001.
resume_task:
	sbclr       #0x05
	call        initialize_registers
	lris        $AC0.M, #0x01
	call        send_task_mail
	sbset       #0x05
	jmp         command_loop

; 0053: Initialize status/control and disable address wrapping (WR0..3 = FFFF).
initialize_registers:
	sbset       #0x02
	sbset       #0x03
	sbclr       #0x04
	sbset       #0x06
	set16
	clr15
	m0
	lri         $AC0.M, #0xffff
	mrr         $WR0, $AC0.M
	mrr         $WR1, $AC0.M
	mrr         $WR2, $AC0.M
	mrr         $WR3, $AC0.M
	lri         $CR, #0x00ff
	ret

; 0063: Copy pairs of words from staged arguments at DRAM 0358 to AR0.
copy_command_arguments:
	lri         $AC0.H, #0x0000
	lris        $AC0.L, #0x00
	lri         $AR1, #COMMAND_ARGUMENTS
	bloop       $AC0.M, loc_006d
	lrri        $AC0.M, @$AR1
	srri        @$AR0, $AC0.M
	lrri        $AC0.M, @$AR1

loc_006d:
	srri        @$AR0, $AC0.M
	ret

loc_006f:
	jmp         acknowledge_command

; 0071: 16-entry command dispatch table; JMP instructions, not address words.
command_dispatch_table:
	jmp         acknowledge_command
	jmp         command_setup
	jmp         command_render
	jmp         loc_006f
	jmp         command_dma_read
	jmp         command_dma_write
	jmp         command_copy_aram_to_mram
	jmp         command_exchange_arrays
	jmp         command_multiply_add_arrays
	jmp         command_copy_mram
	jmp         acknowledge_command
	jmp         acknowledge_command
	jmp         acknowledge_command
	jmp         acknowledge_command
	jmp         acknowledge_command
	jmp         acknowledge_command

; 0091: Command 01: parameter-block/table setup.
command_setup:
	lri         $AR0, #VOICE_TABLE_ADDRESS_H
	lris        $AC0.M, #0x04
	call        copy_command_arguments
	lri         $AR1, #RENDER_TABLES_ADDRESS_H
	lri         $AC1.M, #RESAMPLING_COEFFICIENTS
	lri         $AR0, #0x0280
	call        dma_read_pointer
	lri         $AR1, #AFC_TABLE_ADDRESS_H
	lri         $AC1.M, #AFC_COEFFICIENTS
	lri         $AR0, #0x0020
	call        dma_read_pointer
	lr          $AC0.M, @COMMAND_EXTRA_DATA
	sr          @RENDER_VOICE_COUNT, $AC0.M
	call        initialize_modulated_delay
	jmp         acknowledge_command

; 00AE: Fetch one 0xC0-word voice block into DRAM 0400.
fetch_voice_parameters:
	lri         $AR1, #CURRENT_VOICE_ADDRESS_H
	lri         $AC1.M, #VOICE_BLOCK
	lri         $AR0, #0x00c0
	call        dma_read_pointer
	ret

; 00B7: Write back only the first 0x80 words of the voice block.
store_voice_state:
	lri         $AR1, #CURRENT_VOICE_ADDRESS_H
	lri         $AC1.M, #VOICE_BLOCK
	lri         $AR0, #0x0080
	lri         $AR1, #CURRENT_VOICE_ADDRESS_H
	lrri        $AC0.M, @$AR1
	lrri        $AC0.L, @$AR1
	lri         $AX0.L, #0x0000
	addaxl      $ACC0, $AX0.L
	call        dma_write
	ret

; 00C7: Word-copy helper, pipelined with parallel load/store.
copy_words:
	lrri        $AC0.M, @$AR0
	lrri        $AX0.H, @$AR0
	loop        $AC1.M
	movr'ls     $ACC0, $AX0.H : $AX0.H, $AC0.M
	srri        @$AR3, $AC0.M
	srri        @$AR3, $AX0.H
	ret

; 00CE: Complement/copy helper; not part of the normal render path traced here.
complement_copy_words:
	lrri        $AC0.M, @$AR0
	lrri        $AX0.H, @$AR0
	bloop       $AC1.M, loc_00d5
	not's       $AC0.M : @$AR2, $AC0.M
	movr'ls     $ACC1, $AX0.H : $AX0.H, $AC0.M
	not's       $AC1.M : @$AR2, $AC1.M

loc_00d5:
	movr'ls     $ACC0, $AX0.H : $AX0.H, $AC1.M
	nop
	ret

; 00D8: Add scaled source into destination, Q1.15 gain.
add_scaled_buffer:
	m2
	lsr         $ACC1, #-1
	mrr         $AR1, $AR0
	mrr         $AR0, $AR3
	lrri        $AX0.H, @$AR1
	mul'l       $AX0.L, $AX0.H : $AX0.H, @$AR1
	mulmvz'l    $AX0.L, $AX0.H, $ACC0 : $AX1.H, @$AR3
	bloop       $AC1.M, loc_00e4
	addr'l      $ACC0, $AX1.H : $AX0.H, @$AR1
	mulmvz'sl   $AX0.L, $AX0.H, $ACC0 : $AC0.M, $AX1.H
	addr'l      $ACC0, $AX1.H : $AX0.H, @$AR1

loc_00e4:
	mulmvz'sl   $AX0.L, $AX0.H, $ACC0 : $AC0.M, $AX1.H
	m0
	ret

; 00E7: Copy scaled source into destination, Q1.15 gain.
copy_scaled_buffer:
	m2
	lrri        $AX0.H, @$AR0
	mul'l       $AX0.L, $AX0.H : $AX0.H, @$AR0
	mulmvz'l    $AX0.L, $AX0.H, $ACC0 : $AX0.H, @$AR0
	loop        $AC1.M
	mulmvz'ls   $AX0.L, $AX0.H, $ACC0 : $AX0.H, $AC0.M
	m0
	ret

; 00EF: Block preparation: fold previous rear buses into stereo, then clear transient buses.
prepare_rear_and_front_buses:
	lris        $AC1.M, #0x50
	lri         $AR0, #BUS_REAR_LEFT
	lri         $AR3, #BUS_FRONT_LEFT
	lri         $AX0.L, #0x7fff
	call        copy_scaled_buffer
	lris        $AC1.M, #0x50
	lri         $AR0, #BUS_REAR_LEFT
	lri         $AR3, #BUS_FRONT_RIGHT
	lri         $AX0.L, #0xb820
	call        copy_scaled_buffer
	clr         $ACC1
	lris        $AC1.M, #0x28
	lri         $AR0, #BUS_REAR_RIGHT_SECOND_HALF
	lri         $AR3, #BUS_FRONT_LEFT
	lri         $AX0.L, #0xb820
	call        add_scaled_buffer
	clr         $ACC1
	lris        $AC1.M, #0x28
	lri         $AR0, #BUS_REAR_RIGHT_SECOND_HALF
	lri         $AR3, #BUS_FRONT_RIGHT
	lri         $AX0.L, #0x7fff
	call        add_scaled_buffer
	clr         $ACC0
	clr         $ACC1
	lris        $AC0.M, #0x50
	lri         $AR0, #BUS_REAR_RIGHT
	loop        $AC0.M
	srri        @$AR0, $AC1.M
	lri         $AR0, #BUS_REAR_LEFT
	loop        $AC0.M
	srri        @$AR0, $AC1.M
	lri         $AR0, #BUS_AUX_RIGHT_SUBTRACT
	loop        $AC0.M
	srri        @$AR0, $AC1.M
	lri         $AR0, #BUS_MODULATED_DELAY
	loop        $AC0.M
	srri        @$AR0, $AC1.M
	lri         $AR0, #BUS_AUX_CENTER
	loop        $AC0.M
	srri        @$AR0, $AC1.M
	ret

; 012D: Read one effects delay block, optional 8-tap FIR, two destination sends.
read_effects_line:
	lr          $AR0, @EFFECTS_RING_INDEX_POINTER
	lrri        $AX0.H, @$AR0
	lr          $AC1.M, @EFFECTS_WORK_BUFFER_POINTER
	lri         $AX1.H, #0x00a0
	lri         $AR1, #EFFECTS_LINE_ADDRESS_L
	lrrd        $AC0.L, @$AR1
	mulx'l      $AX0.H, $AX1.H : $AC0.M, @$AR1
	mulxac      $AX0.H, $AX1.H, $ACC0
	lri         $AR0, #0x0050
	addis       $AC1.M, #0x08
	call        dma_read
	lr          $AC0.M, @EFFECTS_LINE_FLAGS
	andf        $AC0.M, #0x0001
	jlz         loc_014b
	lri         $AR0, #EFFECTS_LINE_FIR_COEFFICIENTS
	lris        $AC0.M, #0x08
	lr          $AR1, @EFFECTS_WORK_BUFFER_POINTER
	call        filter_fir8

loc_014b:
	lris        $AC1.M, #0x50
	lr          $AR0, @EFFECTS_WORK_BUFFER_POINTER
	lr          $AX0.H, @EFFECTS_LINE_SEND_0_DESTINATION
	tstaxh      $AX0.H
	jz          loc_0158
	mrr         $AR3, $AX0.H
	lr          $AX0.L, @EFFECTS_LINE_SEND_0_GAIN
	call        add_scaled_buffer

loc_0158:
	lris        $AC1.M, #0x50
	lr          $AR0, @EFFECTS_WORK_BUFFER_POINTER
	lr          $AX0.H, @EFFECTS_LINE_SEND_1_DESTINATION
	tstaxh      $AX0.H
	jz          loc_0165
	mrr         $AR3, $AX0.H
	lr          $AX0.L, @EFFECTS_LINE_SEND_1_GAIN
	call        add_scaled_buffer

loc_0165:
	lr          $AC0.M, @EFFECTS_LINE_FLAGS
	andf        $AC0.M, #0x0002
	retlz
	lri         $AR0, #EFFECTS_LINE_FIR_COEFFICIENTS
	lris        $AC0.M, #0x08
	lr          $AR1, @EFFECTS_WORK_BUFFER_POINTER
	call        filter_fir8
	ret

; 0172: Prepare four effects lines; fold previous rear effects sends into front sends.
prepare_effects_lines:
	lri         $AC1.M, #BUS_EFFECTS_0
	sr          @EFFECTS_WORK_BUFFER_POINTER, $AC1.M
	lri         $AC1.M, #EFFECTS_PARAMETERS
	sr          @EFFECTS_PARAMETERS_POINTER, $AC1.M
	lri         $AC1.M, #EFFECTS_RING_INDICES
	sr          @EFFECTS_RING_INDEX_POINTER, $AC1.M
	bloopi      #0x04, loc_01a5
	lr          $AR0, @EFFECTS_PARAMETERS_POINTER
	lri         $AR3, #EFFECTS_LINE_FLAGS
	lris        $AC1.M, #0x0e
	call        copy_words
	lr          $AX0.H, @EFFECTS_LINE_FLAGS
	tstaxh      $AX0.H
	jz          loc_0196
	lr          $AC1.M, @EFFECTS_WORK_BUFFER_POINTER
	mrr         $AR3, $AC1.M
	addis       $AC1.M, #0x50
	mrr         $AR0, $AC1.M
	lris        $AC1.M, #0x06
	call        copy_words
	call        read_effects_line

loc_0196:
	lr          $AC0.M, @EFFECTS_PARAMETERS_POINTER
	addis       $AC0.M, #0x10
	sr          @EFFECTS_PARAMETERS_POINTER, $AC0.M
	lr          $AC0.M, @EFFECTS_WORK_BUFFER_POINTER
	addis       $AC0.M, #0x60
	sr          @EFFECTS_WORK_BUFFER_POINTER, $AC0.M
	lr          $AC0.M, @EFFECTS_RING_INDEX_POINTER
	incm        $AC0.M
	sr          @EFFECTS_RING_INDEX_POINTER, $AC0.M

loc_01a5:
	nop
	lris        $AC1.M, #0x50
	lri         $AR0, #BUS_REAR_LEFT_FX
	lri         $AR3, #BUS_FRONT_LEFT_FX
	lri         $AX0.L, #0x7fff
	call        add_scaled_buffer
	lris        $AC1.M, #0x50
	lri         $AR0, #BUS_REAR_LEFT_FX
	lri         $AR3, #BUS_FRONT_RIGHT_FX
	lri         $AX0.L, #0xb820
	call        add_scaled_buffer
	lris        $AC1.M, #0x28
	lri         $AR0, #BUS_REAR_RIGHT_FX_SECOND_HALF
	lri         $AR3, #BUS_FRONT_LEFT_FX
	lri         $AX0.L, #0xb820
	call        add_scaled_buffer
	lris        $AC1.M, #0x28
	lri         $AR0, #BUS_REAR_RIGHT_FX_SECOND_HALF
	lri         $AR3, #BUS_FRONT_RIGHT_FX
	lri         $AX0.L, #0x7fff
	call        add_scaled_buffer
	clr         $ACC0
	clr         $ACC1
	lris        $AC0.M, #0x50
	lri         $AR0, #BUS_REAR_LEFT_FX
	loop        $AC0.M
	srri        @$AR0, $AC1.M
	lri         $AR0, #BUS_REAR_RIGHT_FX
	loop        $AC0.M
	srri        @$AR0, $AC1.M
	ret

; 01D6: Write one effects block to its external ring slot, advance/wrap slot index.
write_effects_line:
	lr          $AR0, @EFFECTS_RING_INDEX_POINTER
	lrr         $AX0.H, @$AR0
	clr         $ACC0
	lrr         $AC0.M, @$AR0
	lr          $AX1.H, @EFFECTS_LINE_RING_LENGTH
	incm        $AC0.M
	cmpaxh      $ACC0, $AX1.H
	ifge
	clr         $ACC0
	srri        @$AR0, $AC0.M
	lr          $AC1.M, @EFFECTS_WORK_BUFFER_POINTER
	lri         $AX1.H, #0x00a0
	lri         $AR1, #EFFECTS_LINE_ADDRESS_L
	lrrd        $AC0.L, @$AR1
	mulx'l      $AX0.H, $AX1.H : $AC0.M, @$AR1
	mulxac      $AX0.H, $AX1.H, $ACC0
	lri         $AR0, #0x0050
	call        dma_write
	ret

; 01F0: Finish rear effects cross-block contribution, then write four effects lines.
finish_effects_lines:
	clr         $ACC1
	lris        $AC1.M, #0x28
	lri         $AR0, #BUS_REAR_RIGHT_FX
	lri         $AR3, #BUS_FRONT_LEFT_FX_SECOND_HALF
	lri         $AX0.L, #0xb820
	call        add_scaled_buffer
	clr         $ACC1
	lris        $AC1.M, #0x28
	lri         $AR0, #BUS_REAR_RIGHT_FX
	lri         $AR3, #BUS_FRONT_RIGHT_FX_SECOND_HALF
	lri         $AX0.L, #0x7fff
	call        add_scaled_buffer
	lri         $AC1.M, #BUS_EFFECTS_0
	sr          @EFFECTS_WORK_BUFFER_POINTER, $AC1.M
	lri         $AC1.M, #EFFECTS_PARAMETERS
	sr          @EFFECTS_PARAMETERS_POINTER, $AC1.M
	lri         $AC1.M, #EFFECTS_RING_INDICES
	sr          @EFFECTS_RING_INDEX_POINTER, $AC1.M
	bloopi      #0x04, loc_022f
	lr          $AR0, @EFFECTS_PARAMETERS_POINTER
	lri         $AR3, #EFFECTS_LINE_FLAGS
	lris        $AC1.M, #0x0e
	call        copy_words
	lr          $AX0.H, @EFFECTS_LINE_FLAGS
	tstaxh      $AX0.H
	jz          loc_0220
	call        write_effects_line

loc_0220:
	lr          $AC0.M, @EFFECTS_PARAMETERS_POINTER
	addis       $AC0.M, #0x10
	sr          @EFFECTS_PARAMETERS_POINTER, $AC0.M
	lr          $AC0.M, @EFFECTS_WORK_BUFFER_POINTER
	addis       $AC0.M, #0x60
	sr          @EFFECTS_WORK_BUFFER_POINTER, $AC0.M
	lr          $AC0.M, @EFFECTS_RING_INDEX_POINTER
	incm        $AC0.M
	sr          @EFFECTS_RING_INDEX_POINTER, $AC0.M

loc_022f:
	nop
	ret

; 0231: Fetch four 16-word effects parameter blocks into 03A8.
fetch_effects_parameters:
	lri         $AR1, #EFFECTS_TABLE_ADDRESS_H
	lri         $AC1.M, #EFFECTS_PARAMETERS
	lri         $AR0, #0x0040
	call        dma_read_pointer
	ret

; 023A: Add AX0 to a stored 32-bit pointer.
advance_external_pointer:
	lrri        $AC0.M, @$AR0
	lrrd        $AC0.L, @$AR0
	addax       $ACC0, $AX0
	srri        @$AR0, $AC0.M
	srri        @$AR0, $AC0.L
	ret

; 0240: Wait until CPU releases this block (DRAM 034E == 0).
wait_for_cpu_release:
	clr         $ACC0
	lr          $AC0.M, @CPU_RELEASE_GATE
	tst         $ACC0
	jnz         wait_for_cpu_release
	ret

; 0247: Command 02: render requested 80-sample blocks to two MRAM output pointers.
command_render:
	lri         $AR0, #OUTPUT_LEFT_ADDRESS_H
	lri         $AR1, #copy_command_arguments
	lris        $AC0.M, #0x02
	callr       $AR1
	lr          $AC0.M, @COMMAND_HEADER_LOW_BYTE
	sr          @RENDER_BLOCKS_REMAINING, $AC0.M
	lr          $AC0.M, @COMMAND_EXTRA_DATA
	sr          @MASTER_GAIN, $AC0.M
	clr         $ACC0
	sr          @CURRENT_BLOCK_INDEX, $AC0.M
	call        fetch_effects_parameters
	lr          $AC0.M, @RENDER_BLOCKS_REMAINING
	bloop       $AC0.M, loc_0448

; 025E: Per-block preparation: rear fold, effects reads, generated-pattern updates.
render_block:
	call        prepare_rear_and_front_buses
	call        prepare_effects_lines
	call        update_waveform_patterns
	call        wait_for_cpu_release
	lr          $AC0.M, @CURRENT_BLOCK_INDEX
	incm        $AC0.M
	sr          @CURRENT_BLOCK_INDEX, $AC0.M
	clr         $ACC0
	sr          @CURRENT_VOICE_INDEX, $AC0.M
	lr          $AC0.M, @RENDER_VOICE_COUNT
	bloop       $AC0.M, loc_03dc

; 0272: Per-voice loop: test bit in CPU-supplied 64-voice active mask.
render_voice:
	clr         $ACC0
	clr         $ACC1
	lr          $AC0.M, @CURRENT_VOICE_INDEX
	lsr         $ACC0, #-4
	addi        $AC0.M, #ACTIVE_VOICE_MASK_0
	mrr         $AR0, $AC0.M
	lrr         $AC1.M, @$AR0
	lr          $AC0.M, @CURRENT_VOICE_INDEX
	andi        $AC0.M, #0x000f
	lsrnr       $ACC1, $AC0.M
	andcf       $AC1.M, #0x8000
	jlnz        next_voice

; 0284: Voice address = voice table base + voice_index * 0x180 BYTES.
	lr          $AX0.L, @CURRENT_VOICE_INDEX
	lri         $AX0.H, #0x0180
	clr         $ACC0
	lr          $AC0.M, @VOICE_TABLE_ADDRESS_H
	lr          $AC0.L, @VOICE_TABLE_ADDRESS_L
	mul         $AX0.L, $AX0.H
	mulac       $AX0.L, $AX0.H, $ACC0
	sr          @CURRENT_VOICE_ADDRESS_H, $AC0.M
	sr          @CURRENT_VOICE_ADDRESS_L, $AC0.L

; 0293: DMA voice into 0400; skip if disabled or already done.
	call        fetch_voice_parameters
	lr          $AX0.H, @VOICE_ENABLED
	tstaxh      $AX0.H
	jz          next_voice
	lr          $AX0.H, @VOICE_DONE
	tstaxh      $AX0.H
	jnz         next_voice
	lr          $AX0.H, @VOICE_CONSTANT_SAMPLE
	sr          @SAVED_VOICE_CONSTANT_SAMPLE, $AX0.H

; 02A3: Constant/paused source bypasses source advance and resampling.
	lr          $AX0.H, @VOICE_USE_CONSTANT_SAMPLE
	tstaxh      $AX0.H
	jnz         load_constant_voice

; 02A8: Dispatch ARAM AFC/PCM, MRAM PCM (20/21), or generated waveform.
	clr         $ACC0
	lr          $AC0.M, @VOICE_SOURCE_TYPE
	cmpis       $AC0.M, #0x09
	jz          load_afc_source
	cmpis       $AC0.M, #0x05
	jz          load_afc_source
	cmpis       $AC0.M, #0x08
	jz          load_pcm8_aram
	cmpis       $AC0.M, #0x10
	jz          load_pcm16_aram
	cmpis       $AC0.M, #0x20
	jz          load_pcm16_mram_direct
	cmpis       $AC0.M, #0x21
	jz          load_pcm16_mram_resampled
	jmp         generate_waveform

; 02BF: Compute raw input count from Q4.12 pitch and saved fraction.
load_afc_source:
	lr          $AX0.L, @VOICE_PITCH
	clr         $ACC0
	clr         $ACC1
	lr          $AC0.L, @VOICE_PHASE_FRACTION
	set15
	lris        $AX1.L, #0x50
	mulx        $AX0.L, $AX1.L
	mulxac      $AX0.L, $AX1.L, $ACC0
	lsl         $ACC0, #4
	clr15
	mrr         $AC1.M, $AC0.M
	lri         $AR3, #RAW_SAMPLE_BUFFER
	clr         $ACC0
	lr          $AC0.M, @VOICE_SOURCE_TYPE
	cmpis       $AC0.M, #0x05
	jz          loc_02e3
	lr          $AX0.H, @VOICE_LOOP_ENABLED
	tstaxh      $AX0.H
	jz          loc_02e7
	lr          $AX0.H, @VOICE_LOOP_ADDRESS_L
	clr         $ACC0
	lr          $AC0.M, @VOICE_LOOP_END_POSITION_L
	orr         $AC0.M, $AX0.H
	andi        $AC0.M, #0x000f
	jz          loc_02e7

; 02E3: General buffered AFC path, also handles unaligned loop boundaries.
loc_02e3:
	call        load_afc_buffered
	jmp         resample_voice

; 02E7: Aligned HQ AFC streaming path.
loc_02e7:
	call        load_afc_hq_aligned

; 02E9: Resample raw input at 0580 to 80 voice samples at 0520.
resample_voice:
	lri         $AR0, #RAW_SAMPLE_BUFFER
	lri         $AR1, #VOICE_SAMPLE_BUFFER
	lri         $AX1.L, #0x0000
	call        resample

; 02F1: Optional distance filter, coefficient at 04A8 (VPB byte 0150).
filter_voice:
	lr          $AX0.H, @VOICE_DISTANCE_COEFFICIENT
	tstaxh      $AX0.H
	jz          loc_02fa
	lri         $AR0, #VOICE_SAMPLE_BUFFER
	call        filter_distance

loc_02fa:
	lri         $AC0.M, #VOICE_SAMPLE_BUFFER
	sr          @FILTERED_VOICE_POINTER, $AC0.M

; 02FE: Optional variable FIR: low 5 bits of VPB filter mode give tap count.
	clr         $ACC1
	lr          $AC1.M, @VOICE_FILTER_MODE
	andi        $AC1.M, #0x001f
	tst         $ACC1
	jz          check_recursive_filter
	lr          $AC0.M, @FILTERED_VOICE_POINTER
	sub         $ACC0, $ACC1
	sr          @FILTERED_VOICE_POINTER, $AC0.M
	mrr         $AR3, $AC0.M
	lri         $AR0, #VOICE_FIR_HISTORY
	addis       $AC1.M, #0xfe
	call        copy_words
	lri         $AR0, #VOICE_FIR_COEFFICIENTS
	lr          $AR1, @FILTERED_VOICE_POINTER
	clr         $ACC1
	lr          $AC1.M, @VOICE_FILTER_MODE
	andi        $AC1.M, #0x001f
	call        filter_fir_variable
	lr          $AC0.M, @FILTERED_VOICE_POINTER
	addis       $AC0.M, #0x50
	mrr         $AR0, $AC0.M
	lri         $AR3, #VOICE_FIR_HISTORY
	clr         $ACC1
	lr          $AC1.M, @VOICE_FILTER_MODE
	andi        $AC1.M, #0x001f
	addis       $AC1.M, #0xfe
	call        copy_words

; 032A: Optional 4-coefficient recursive filter, enabled by filter-mode bit 5.
check_recursive_filter:
	lr          $AC0.M, @VOICE_FILTER_MODE
	andi        $AC0.M, #0x0020
	jz          select_voice_mixer
	lri         $AR0, #VOICE_RECURSIVE_COEFFICIENTS
	lr          $AR1, @FILTERED_VOICE_POINTER
	lri         $AR2, #VOICE_RECURSIVE_HISTORY
	lri         $AR3, #VOICE_RECURSIVE_COEFFICIENT_LAST
	lrrd        $AX0.H, @$AR3
	tstaxh      $AX0.H
	jnz         loc_034a
	lrrd        $AX0.H, @$AR3
	tstaxh      $AX0.H
	jnz         loc_034a
	lrrd        $AX0.H, @$AR3
	tstaxh      $AX0.H
	jnz         loc_034a
	clr         $ACC0
	lrrd        $AC0.M, @$AR3
	cmpi        $AC0.M, #0x7fff
	jz          select_voice_mixer

loc_034a:
	call        filter_recursive

; 034C: Choose automatic positional mixer or six explicitly routed mixer sends.
select_voice_mixer:
	clr         $ACC0
	lr          $AC0.M, @VOICE_USE_POSITIONAL_MIXER
	sr          @DATA_042D, $AC0.M
	tst         $ACC0
	jz          loc_0358
	call        mix_positional_voice
	jmp         finish_voice

loc_0358:
	clr         $ACC0
	mrr         $IX0, $AC0.M
	mrr         $IX2, $AC0.M
	incm        $AC0.M
	mrr         $IX3, $AC0.M

; 035D: Restore requested preceding samples for per-send delays.
	clr         $ACC0
	lr          $AC0.M, @VOICE_SAVED_SAMPLE_COUNT
	tst         $ACC0
	jz          loc_0370
	lr          $AR3, @FILTERED_VOICE_POINTER
	dar         $AR3
	lri         $AR0, #VOICE_SEND_DELAY_HISTORY_END
	lri         $IX0, #0xffff
	lri         $IX3, #0xffff
	lrrn        $AX0.H, @$AR0
	movr'ln     $ACC1, $AX0.H : $AX0.H, @$AR0
	loop        $AC0.M
	movr'lsnm   $ACC1, $AX0.H : $AX0.H, $AC1.M

; 0370: Requested voice stop: halve six current gains; finish once all zero.
loc_0370:
	lr          $AX0.H, @VOICE_STOP_REQUESTED
	tstaxh      $AX0.H
	jz          mix_voice_sends
	clr         $ACC1
	lri         $IX2, #0x0005
	lri         $AR2, #VOICE_SEND_0_GAIN_CURRENT
	bloopi      #0x06, loc_037e
	lrrd        $AC0.M, @$AR2
	lsr         $ACC0, #-1

loc_037e:
	add'sn      $ACC1, $ACC0 : @$AR2, $AC0.M
	tst         $ACC1
	jnz         mix_voice_sends
	lri         $AX0.H, #0x0001
	sr          @VOICE_DONE, $AX0.H

; 0386: Six-send mixing loop; compute gain delta / 32 in full fixed-point accumulator.
mix_voice_sends:
	set40
	lri         $IX2, #0x0002
	lri         $AR2, #VOICE_SEND_0_DESTINATION
	bloopi      #0x06, loc_03b6
	clr         $ACC0
	lrri        $AC0.M, @$AR2
	sbclr       #0x00
	tst         $ACC0
	ifz
	sbset       #0x00
	mrr         $AR3, $AC0.M
	lrri        $AC0.M, @$AR2
	lrri        $AC1.M, @$AR2
	sub         $ACC0, $ACC1
	asr         $ACC0, #-5
	mrr         $AX0.H, $AC0.M
	mrr         $AX0.L, $AC0.L

; 039A: Send delay word: high byte moves one step toward low byte; low byte offsets input.
	lrr         $AC0.M, @$AR2
	andi        $AC0.M, #0x00ff
	mrr         $AX1.H, $AC0.M
	lrr         $AC0.M, @$AR2
	lsr         $ACC0, #-8
	lri         $AC0.L, #0x0000
	cmpaxh      $ACC0, $AX1.H
	jz          loc_03ab
	lrr         $AC0.M, @$AR2
	ifg
	incm        $AC0.M
	ifl
	decm        $AC0.M
	srr         @$AR2, $AC0.M

loc_03ab:
	dar         $AR2
	lr          $AC0.M, @FILTERED_VOICE_POINTER
	subr        $ACC0, $AX1.H
	jlz         loc_03b4
	mrr         $AR0, $AC0.M
	call        mix_buffer_with_gain_ramp

loc_03b4:
	nop
	srri        @$AR2, $AC1.M

loc_03b6:
	iar         $AR2

; 03B7: Save trailing samples for delayed sends in the next block.
	set16
	clr         $ACC0
	lr          $AC0.M, @VOICE_SAVED_SAMPLE_COUNT
	tst         $ACC0
	jz          finish_voice
	lr          $AR3, @FILTERED_VOICE_POINTER
	lri         $IX3, #0x004f
	addarn      $AR3, $IX3
	lri         $AR0, #VOICE_SEND_DELAY_HISTORY_END
	lri         $IX0, #0xffff
	lri         $IX3, #0xffff
	lrrn        $AX0.H, @$AR3
	movr'ln     $ACC1, $AX0.H : $AX0.H, @$AR3
	loop        $AC0.M
	movr'slnm   $ACC1, $AX0.H : $AC1.M, $AX0.H

; 03CD: Clear reset flag unless constant/paused; write mutable voice state back.
finish_voice:
	lr          $AX0.H, @VOICE_USE_CONSTANT_SAMPLE
	tstaxh      $AX0.H
	jnz         loc_03d5
	clr         $ACC0
	sr          @VOICE_RESET, $AC0.M

loc_03d5:
	call        store_voice_state

next_voice:
	lr          $AC0.M, @CURRENT_VOICE_INDEX
	incm        $AC0.M
	sr          @CURRENT_VOICE_INDEX, $AC0.M

loc_03dc:
	nop

; 03DD: Set CPU gate, notify DCD10004 / F355FFxx; block counter starts at 1 here.
notify_block_processed:
	lris        $AC0.M, #0x01
	sr          @CPU_RELEASE_GATE, $AC0.M
	lris        $AC0.M, #0x04
	call        send_task_mail
	lr          $AC0.M, @CURRENT_BLOCK_INDEX
	ori         $AC0.M, #0xff00
	call        send_audio_mail

; 03E9: Post-voice delay/modulation path at 0C6B, 0C7D, 0CD2.
	call        write_modulated_delay
	call        read_modulated_delay
	call        mix_modulated_delay
	lr          $AC0.M, @RENDER_BLOCKS_REMAINING
	decm        $AC0.M
	sr          @RENDER_BLOCKS_REMAINING, $AC0.M

; 03F4: Mix auxiliary 09A0 into both fronts at gain 5A82 (~1/sqrt(2)).
	lri         $AR0, #BUS_AUX_CENTER
	lri         $AR3, #BUS_FRONT_LEFT
	lris        $AC1.M, #0x50
	lri         $AX0.L, #0x5a82
	call        add_scaled_buffer
	lri         $AR0, #BUS_AUX_CENTER
	lri         $AR3, #BUS_FRONT_RIGHT
	lris        $AC1.M, #0x50
	call        add_scaled_buffer

; 0404: Fold first 40 samples of current rear-right into last 40 front samples.
	clr         $ACC1
	lris        $AC1.M, #0x28
	lri         $AR0, #BUS_REAR_RIGHT
	lri         $AR3, #BUS_FRONT_LEFT_SECOND_HALF
	lri         $AX0.L, #0xb820
	call        add_scaled_buffer
	clr         $ACC1
	lris        $AC1.M, #0x28
	lri         $AR0, #BUS_REAR_RIGHT
	lri         $AR3, #BUS_FRONT_RIGHT_SECOND_HALF
	lri         $AX0.L, #0x7fff
	call        add_scaled_buffer

; 0418: Apply master Q4.12 gain and DMA 80 left samples to MRAM.
	lri         $AR3, #BUS_FRONT_LEFT
	call        apply_master_gain
	lri         $AR1, #OUTPUT_LEFT_ADDRESS_H
	lri         $AC1.M, #BUS_FRONT_LEFT
	lri         $AR0, #0x0050
	call        dma_write_pointer

; 0424: Add 0FA0 to right at gain 8000 (negative unity), master gain, DMA right.
	lri         $AR0, #BUS_AUX_RIGHT_SUBTRACT
	lri         $AR3, #BUS_FRONT_RIGHT
	lris        $AC1.M, #0x50
	lri         $AX0.L, #0x8000
	call        add_scaled_buffer
	lri         $AR3, #BUS_FRONT_RIGHT
	call        apply_master_gain
	lri         $AR1, #OUTPUT_RIGHT_ADDRESS_H
	lri         $AC1.M, #BUS_FRONT_RIGHT
	lri         $AR0, #0x0050
	call        dma_write_pointer

; 0439: Advance each output pointer by 0xA0 BYTES, write effects rings.
	lri         $AX0.H, #0x0000
	lri         $AX0.L, #0x00a0
	lri         $AR0, #OUTPUT_LEFT_ADDRESS_H
	call        advance_external_pointer
	lri         $AR0, #OUTPUT_RIGHT_ADDRESS_H
	call        advance_external_pointer
	call        finish_effects_lines
	nop

loc_0448:
	nop

; 0449: Render batch finished; enter scheduler handshake, continuation = dispatcher.
finish_render_batch:
	lri         $AR0, #command_loop
	jmp         wait_for_task_action

; 044D: Command 07 utility body: DMA two arrays, exchange them; usage unverified.
command_exchange_arrays:
	lri         $AR0, #UTILITY_ARGUMENTS
	call        copy_command_arguments
	call        copy_command_arguments
	lri         $AR1, #UTILITY_ARGUMENTS
	lrri        $AC0.M, @$AR1
	lrri        $AC0.L, @$AR1
	lri         $AC1.M, #VOICE_BLOCK
	lr          $AR0, @COMMAND_EXTRA_DATA
	call        dma_read
	lri         $AR1, #0x0348
	lrri        $AC0.M, @$AR1
	lrri        $AC0.L, @$AR1
	lri         $AC1.M, #0x0800
	lr          $AR0, @COMMAND_EXTRA_DATA
	call        dma_read
	lri         $AR1, #UTILITY_ARGUMENTS
	lrri        $AC0.M, @$AR1
	lrri        $AC0.L, @$AR1
	lri         $AC1.M, #0x0800
	lr          $AR0, @COMMAND_EXTRA_DATA
	call        dma_write
	lri         $AR1, #0x0348
	lrri        $AC0.M, @$AR1
	lrri        $AC0.L, @$AR1
	lri         $AC1.M, #VOICE_BLOCK
	lr          $AR0, @COMMAND_EXTRA_DATA
	call        dma_write
	jmp         acknowledge_command

; 047D: Command 09 utility body: MRAM copy via DRAM; usage unverified.
command_copy_mram:
	lri         $AR0, #UTILITY_ARGUMENTS
	call        copy_command_arguments
	call        copy_command_arguments
	lri         $AR1, #UTILITY_ARGUMENTS
	lrri        $AC0.M, @$AR1
	lrri        $AC0.L, @$AR1
	lri         $AC1.M, #VOICE_BLOCK
	lr          $AR0, @COMMAND_EXTRA_DATA
	call        dma_read
	lri         $AR1, #0x0348
	lrri        $AC0.M, @$AR1
	lrri        $AC0.L, @$AR1
	lri         $AC1.M, #VOICE_BLOCK
	lr          $AR0, @COMMAND_EXTRA_DATA
	call        dma_write
	jmp         acknowledge_command

; 0499: Command 06 utility body: ARAM read then MRAM write; usage unverified.
command_copy_aram_to_mram:
	lri         $AR0, #UTILITY_ARGUMENTS
	call        copy_command_arguments
	call        copy_command_arguments
	lri         $AR1, #UTILITY_ARGUMENTS
	lrri        $AC0.M, @$AR1
	lrri        $AC0.L, @$AR1
	lri         $AC1.M, #VOICE_BLOCK
	lr          $AR0, @COMMAND_EXTRA_DATA
	call        aram_read
	lri         $AR1, #0x0348
	lrri        $AC0.M, @$AR1
	lrri        $AC0.L, @$AR1
	lri         $AC1.M, #VOICE_BLOCK
	lr          $AR0, @COMMAND_EXTRA_DATA
	call        dma_write
	jmp         acknowledge_command

; 04B5: Command 08 utility body: multiply/add arrays; usage unverified.
command_multiply_add_arrays:
	lri         $AR0, #UTILITY_ARGUMENTS
	call        copy_command_arguments
	call        copy_command_arguments
	lri         $AR1, #UTILITY_ARGUMENTS
	lrri        $AC0.M, @$AR1
	lrri        $AC0.L, @$AR1
	lri         $AC1.M, #VOICE_BLOCK
	lr          $AR0, @COMMAND_HEADER_LOW_BYTE
	call        dma_read
	lri         $AR1, #0x0348
	lrri        $AC0.M, @$AR1
	lrri        $AC0.L, @$AR1
	lri         $AC1.M, #0x0800
	lr          $AR0, @COMMAND_HEADER_LOW_BYTE
	call        dma_read
	lri         $AR0, #VOICE_BLOCK
	lri         $AR3, #0x0800
	lri         $IX0, #0x0000
	lr          $AX0.H, @COMMAND_EXTRA_DATA
	lr          $AC1.M, @COMMAND_HEADER_LOW_BYTE
	set40
	lrri        $AX1.H, @$AR3
	mulx        $AX0.H, $AX1.H
	lrri        $AX1.H, @$AR3
	bloop       $AC1.M, loc_04e2
	lrrn        $AC0.M, @$AR0
	mulxac      $AX0.H, $AX1.H, $ACC0
	nx'sl       : $AC0.M, $AX1.H

loc_04e2:
	nop
	set16
	lri         $AR1, #UTILITY_ARGUMENTS
	lrri        $AC0.M, @$AR1
	lrri        $AC0.L, @$AR1
	lri         $AC1.M, #VOICE_BLOCK
	lr          $AR0, @COMMAND_HEADER_LOW_BYTE
	call        dma_write
	jmp         acknowledge_command

; 04F0: MRAM -> DRAM DMA; read 32-bit MRAM pointer from AR1.
dma_read_pointer:
	lrri        $AC0.M, @$AR1
	lrri        $AC0.L, @$AR1

; 04F2: DMA input core: DSPA=word address, DSMA=byte address, DSBL=2*AR0.
dma_read:
	srs         @DMA_DSP_WORD_ADDRESS, $AC1.M
	lris        $AC1.M, #0x00

loc_04f4:
	srs         @DMA_CONTROL, $AC1.M
	srs         @DMA_MAIN_ADDRESS_H, $AC0.M
	srs         @DMA_MAIN_ADDRESS_L, $AC0.L
	mrr         $AC1.M, $AR0
	lsl         $ACC1, #1
	srs         @DMA_BYTE_LENGTH, $AC1.M
	call        wait_for_dma
	ret

; 04FD: DRAM -> MRAM DMA; read MRAM pointer from AR1.
dma_write_pointer:
	lrri        $AC0.M, @$AR1
	lrri        $AC0.L, @$AR1

dma_write:
	srs         @DMA_DSP_WORD_ADDRESS, $AC1.M
	lris        $AC1.M, #0x01
	jmp         loc_04f4

; 0503: Wait for DMA busy flag to clear.
wait_for_dma:
	lrs         $AC0.M, @DMA_CONTROL
	andf        $AC0.M, #0x0004
	jlnz        wait_for_dma
	ret

; 0509: Non-waiting DMA input helper.
start_dma_read:
	lrri        $AC0.M, @$AR1
	lrri        $AC0.L, @$AR1
	sr          @DMA_DSP_WORD_ADDRESS, $AC1.M
	lris        $AC1.M, #0x00
	sr          @DMA_CONTROL, $AC1.M
	sr          @DMA_MAIN_ADDRESS_H, $AC0.M
	sr          @DMA_MAIN_ADDRESS_L, $AC0.L
	mrr         $AC1.M, $AR0
	lsl         $ACC1, #1
	sr          @DMA_BYTE_LENGTH, $AC1.M
	ret

; 0519: Wait for DMA, using full addresses independent of CR page.
wait_for_dma_full_address:
	lr          $AC0.M, @DMA_CONTROL
	andf        $AC0.M, #0x0004
	jlnz        wait_for_dma_full_address
	ret

; 0520: Raw ARAM read helper.
aram_read_pointer:
	lrri        $AC0.M, @$AR1
	lrri        $AC0.L, @$AR1

aram_read:
	andi        $AC0.M, #0x7fff
	call        configure_raw_aram_access
	bloop       $AX0.H, loc_052c
	lrs         $AC0.M, @ACCEL_RAW_DATA
	srri        @$AR1, $AC0.M
	nop
	nop

loc_052c:
	nop
	ret

; 052E: Set up raw ARAM accelerator registers.
configure_raw_aram_access:
	mrr         $AR1, $AC1.M
	lris        $AC1.M, #0x05
	srs         @ACCEL_FORMAT, $AC1.M
	mrr         $AX0.H, $AC0.M
	mrr         $AX0.L, $AC0.L
	srs         @ACCEL_START_ADDRESS_H, $AC0.M
	srs         @ACCEL_START_ADDRESS_L, $AC0.L
	clr         $ACC1
	mrr         $AC1.L, $AR0
	add         $ACC0, $ACC1
	addi        $AC0.M, #0x0030
	srs         @ACCEL_END_ADDRESS_H, $AC0.M
	srs         @ACCEL_END_ADDRESS_L, $AC0.L
	mrr         $AC0.M, $AX0.H
	mrr         $AC0.L, $AX0.L
	lsr         $ACC0, #-1
	srs         @ACCEL_CURRENT_ADDRESS_H, $AC0.M
	srs         @ACCEL_CURRENT_ADDRESS_L, $AC0.L
	mrr         $AX0.H, $AR0
	ret

; 0543: Raw ARAM write helper.
aram_write_pointer:
	lrri        $AC0.M, @$AR1
	lrri        $AC0.L, @$AR1
	ori         $AC0.M, #0x8000
	call        configure_raw_aram_access
	bloop       $AX0.H, loc_0550
	lrri        $AC0.M, @$AR1
	srs         @ACCEL_RAW_DATA, $AC0.M
	nop
	nop
	nop

loc_0550:
	nop
	ret

; 0552: Command 04 utility body: MRAM -> DRAM; usage unverified.
command_dma_read:
	lri         $AR0, #UTILITY_ARGUMENTS
	call        copy_command_arguments
	call        copy_command_arguments
	lri         $AR1, #UTILITY_ARGUMENTS
	lr          $AC1.M, @DATA_0349
	andi        $AC1.M, #0xffff
	lr          $AR0, @COMMAND_EXTRA_DATA
	call        dma_read_pointer
	jmp         acknowledge_command

; 0564: Command 05 utility body: DRAM -> MRAM; usage unverified.
command_dma_write:
	lri         $AR0, #UTILITY_ARGUMENTS
	call        copy_command_arguments
	call        copy_command_arguments
	lri         $AR1, #UTILITY_ARGUMENTS
	lr          $AC1.M, @DATA_0349
	andi        $AC1.M, #0xffff
	lr          $AR0, @COMMAND_EXTRA_DATA
	call        dma_write_pointer
	jmp         acknowledge_command

; 0576: Program accelerator format, start/end/current addresses; restores CR=FF.
configure_sample_accelerator:
	lri         $CR, #0x00ff
	srs         @ACCEL_FORMAT, $AC1.M
	andi        $AC1.M, #0x0003
	mrr         $AX1.H, $AC1.M
	mrr         $AX0.H, $AC0.M
	mrr         $AX0.L, $AC0.L
	addi        $AC0.M, #0x0010
	srs         @ACCEL_START_ADDRESS_H, $AC0.M
	srs         @ACCEL_START_ADDRESS_L, $AC0.L
	clr         $ACC1
	mrr         $AC1.L, $AR0
	add         $ACC0, $ACC1
	addi        $AC0.M, #0x0030
	srs         @ACCEL_END_ADDRESS_H, $AC0.M
	srs         @ACCEL_END_ADDRESS_L, $AC0.L
	mrr         $AC0.M, $AX0.H
	mrr         $AC0.L, $AX0.L
	mrr         $AC1.M, $AX1.H
	decm        $AC1.M
	lsrn
	srs         @ACCEL_CURRENT_ADDRESS_H, $AC0.M
	srs         @ACCEL_CURRENT_ADDRESS_L, $AC0.L
	ret

; 0591: CPU interrupt: save registers, receive command or synchronization data.
receive_cpu_interrupt:
	sr          @INTERRUPT_SAVED_ACC0_H, $AC0.H
	sr          @INTERRUPT_SAVED_ACC0_L, $AC0.L
	lsr16       $ACC0
	sr          @INTERRUPT_SAVED_ACC0_M, $AC0.L
	sr          @INTERRUPT_SAVED_AX0_H, $AX0.H
	lr          $AC0.M, @CPU_TO_DSP_MAILBOX_H
	andcf       $AC0.M, #0x8000
	jlnz        queue_task_control
	lr          $AX0.H, @CPU_TO_DSP_MAILBOX_L
	tstaxh      $AX0.H
	jnz         receive_command_payload

; 05A5: Synchronization: clear CPU gate, then receive four 16-bit active-mask words.
receive_active_voice_mask:
	sr          @CPU_RELEASE_GATE, $AX0.H

loc_05a7:
	lr          $AC0.M, @CPU_TO_DSP_MAILBOX_H
	andcf       $AC0.M, #0x8000
	jlnz        loc_05a7
	lr          $AC0.L, @CPU_TO_DSP_MAILBOX_L
	sr          @ACTIVE_VOICE_MASK_0, $AC0.M
	sr          @ACTIVE_VOICE_MASK_1, $AC0.L

loc_05b3:
	lr          $AC0.M, @CPU_TO_DSP_MAILBOX_H
	andcf       $AC0.M, #0x8000
	jlnz        loc_05b3
	lr          $AC0.L, @CPU_TO_DSP_MAILBOX_L
	sr          @ACTIVE_VOICE_MASK_2, $AC0.M
	sr          @ACTIVE_VOICE_MASK_3, $AC0.L

return_from_cpu_interrupt:
	lr          $AC0.M, @INTERRUPT_SAVED_ACC0_M
	lr          $AC0.L, @INTERRUPT_SAVED_ACC0_L
	lr          $AC0.H, @INTERRUPT_SAVED_ACC0_H
	lr          $AX0.H, @INTERRUPT_SAVED_AX0_H
	rti

; 05C8: Task yield path.
yield_task:
	lri         $AX0.H, #0x0002
	sr          @DATA_03A3, $AX0.H
	sr          @TASK_CONTINUATION, $AR0
	call        wait_for_outgoing_mail_acc0
	si          @DSP_TO_CPU_MAILBOX_H, #0xdcd1
	si          @DSP_TO_CPU_MAILBOX_L, #0x0002
	si          @CPU_INTERRUPT_REQUEST, #0x0001
	halt

; 05D7: DATA: four scheduler target addresses, read with ILRR (not executed).
task_action_table:
	cw halt_task
	cw switch_task_context
	cw return_to_rom
	cw continue_task

; 05DB: Send DCD10005; wait for CPU task action, select target from preceding table.
wait_for_task_action:
	sr          @TASK_CONTINUATION, $AR0
	lri         $AC0.M, #0x0005
	call        send_task_mail
	set16
	clr         $ACC0
	clr         $ACC1
	call        wait_for_cpu_mail_acc0
	lrs         $AC1.M, @CPU_TO_DSP_MAILBOX_L
	lri         $AC0.M, #task_action_table
	add         $ACC0, $ACC1
	mrr         $AR3, $AC0.M
	ilrr        $AC1.M, @$AR3
	mrr         $AR3, $AC1.M
	jmpr        $AR3
	halt

halt_task:
	halt

; 05F0: Save/load task context handshake; tail-call DSP ROM at 80B5.
switch_task_context:
	lri         $AX0.H, #0x0002
	sr          @DATA_03A3, $AX0.H
	clr         $ACC0
	clr         $ACC1
	call        wait_for_cpu_mail_acc0
	lrs         $AC0.L, @CPU_TO_DSP_MAILBOX_L
	call        wait_for_cpu_mail_acc1
	lrs         $AC1.L, @CPU_TO_DSP_MAILBOX_L
	call        wait_for_cpu_mail_acc1
	lrs         $AC1.M, @CPU_TO_DSP_MAILBOX_L
	srs         @DMA_MAIN_ADDRESS_H, $AC0.M
	srs         @DMA_MAIN_ADDRESS_L, $AC0.L
	si          @DMA_CONTROL, #0x0001
	srs         @DMA_DSP_WORD_ADDRESS, $AC1.M
	srs         @DMA_BYTE_LENGTH, $AC1.L
	clr         $ACC0
	clr         $ACC1
	call        wait_for_cpu_mail_acc0
	lrs         $AC0.L, @CPU_TO_DSP_MAILBOX_L
	mrr         $IX0, $AC0.M
	mrr         $IX1, $AC0.L
	call        wait_for_cpu_mail_acc1
	lrs         $AC1.L, @CPU_TO_DSP_MAILBOX_L
	call        wait_for_cpu_mail_acc1
	lrs         $AC1.M, @CPU_TO_DSP_MAILBOX_L
	mrr         $IX2, $AC1.M
	mrr         $IX3, $AC1.L
	clr         $ACC0
	call        wait_for_cpu_mail_acc0
	lrs         $AC0.M, @CPU_TO_DSP_MAILBOX_L
	mrr         $AR0, $AC0.M
	clr         $ACC1
	call        wait_for_cpu_mail_acc1
	lrs         $AX0.L, @CPU_TO_DSP_MAILBOX_L
	mrr         $AX0.H, $AC1.M
	call        wait_for_cpu_mail_acc0
	lrs         $AX1.L, @CPU_TO_DSP_MAILBOX_L
	call        wait_for_cpu_mail_acc0
	lrs         $AX1.H, @CPU_TO_DSP_MAILBOX_L

loc_0624:
	lrs         $AC0.M, @DMA_CONTROL
	andf        $AC0.M, #0x0004
	jlnz        loc_0624
	sbclr       #0x06
	sbclr       #0x03
	sbclr       #0x04
	sbclr       #0x05
	jmp         ROM_SWITCH_TASK
	halt

; 0630: Return to ROM boot entry at 8000.
return_to_rom:
	jmp         ROM_BOOT
	halt

; 0633: Continue using saved continuation address.
continue_task:
	lr          $AR0, @TASK_CONTINUATION
	jmpr        $AR0

; 0636: Wait for CPU mailbox word (CMBH full).
wait_for_cpu_mail_acc0:
	lrs         $AC0.M, @CPU_TO_DSP_MAILBOX_H
	andcf       $AC0.M, #0x8000
	jlnz        wait_for_cpu_mail_acc0
	ret

wait_for_cpu_mail_acc1:
	lrs         $AC1.M, @CPU_TO_DSP_MAILBOX_H
	andcf       $AC1.M, #0x8000
	jlnz        wait_for_cpu_mail_acc1
	ret

; 0642: Send DCD1xxxx and request CPU interrupt.
send_task_mail:
	call        wait_for_outgoing_mail_acc1
	si          @DSP_TO_CPU_MAILBOX_H, #0xdcd1
	srs         @DSP_TO_CPU_MAILBOX_L, $AC0.M
	si          @CPU_INTERRUPT_REQUEST, #0x0001
	call        wait_for_outgoing_mail_acc1
	ret

; 064C: Send F355xxxx payload.
send_audio_mail:
	call        wait_for_outgoing_mail_acc1
	si          @DSP_TO_CPU_MAILBOX_H, #0xf355
	srs         @DSP_TO_CPU_MAILBOX_L, $AC0.M
	call        wait_for_outgoing_mail_acc1
	ret

; 0654: Wait for DSP outgoing mailbox to be empty.
wait_for_outgoing_mail_acc0:
	lrs         $AC0.M, @DSP_TO_CPU_MAILBOX_H
	andcf       $AC0.M, #0x8000
	jlz         wait_for_outgoing_mail_acc0
	ret

wait_for_outgoing_mail_acc1:
	lrs         $AC1.M, @DSP_TO_CPU_MAILBOX_H
	andcf       $AC1.M, #0x8000
	jlz         wait_for_outgoing_mail_acc1
	ret

; 0660: Initialize 48-word command ring at 0280.
initialize_command_queue:
	lri         $AX0.H, #COMMAND_QUEUE
	sr          @COMMAND_QUEUE_WRITE_POINTER, $AX0.H
	sr          @COMMAND_QUEUE_READ_POINTER, $AX0.H
	lris        $AX0.H, #0x00
	sr          @PENDING_COMMAND_COUNT, $AX0.H
	ret

; 066A: Interrupt-side receiver: count + command payload into circular command queue.
receive_command_payload:
	sr          @INTERRUPT_SAVED_AR0, $AR0
	sr          @INTERRUPT_SAVED_WR0, $WR0
	lr          $AR0, @COMMAND_QUEUE_WRITE_POINTER
	lri         $WR0, #0x002f
	srri        @$AR0, $AX0.H

loc_0673:
	lr          $AC0.M, @CPU_TO_DSP_MAILBOX_H
	andcf       $AC0.M, #0x8000
	jlnz        loc_0673
	lr          $AC0.L, @CPU_TO_DSP_MAILBOX_L
	srri        @$AR0, $AC0.M
	srri        @$AR0, $AC0.L
	mrr         $AC0.M, $AX0.H
	decm        $AC0.M
	mrr         $AX0.H, $AC0.M
	tstaxh      $AX0.H
	jnz         loc_0673

loc_0683:
	clr         $ACC0
	lr          $AC0.M, @PENDING_COMMAND_COUNT
	incm        $AC0.M
	sr          @PENDING_COMMAND_COUNT, $AC0.M
	sr          @COMMAND_QUEUE_WRITE_POINTER, $AR0
	lr          $AR0, @INTERRUPT_SAVED_AR0
	lr          $WR0, @INTERRUPT_SAVED_WR0
	jmp         return_from_cpu_interrupt

; 0691: Queue task-control marker.
queue_task_control:
	sr          @INTERRUPT_SAVED_AR0, $AR0
	sr          @INTERRUPT_SAVED_WR0, $WR0
	lr          $AR0, @COMMAND_QUEUE_WRITE_POINTER
	lri         $WR0, #0x002f
	lris        $AX0.H, #0x00
	srri        @$AR0, $AX0.H
	jmp         loc_0683

; 069D: Main-loop queue reader and command staging.
read_command_queue:
	lr          $AR0, @COMMAND_QUEUE_READ_POINTER
	lri         $WR0, #0x002f

loc_06a1:
	lr          $AX0.H, @PENDING_COMMAND_COUNT
	tstaxh      $AX0.H
	jz          loc_06c5
	sbclr       #0x05

	lr          $AX0.H, @PENDING_COMMAND_COUNT
	mrr         $AC0.M, $AX0.H
	decm        $AC0.M
	sr          @PENDING_COMMAND_COUNT, $AC0.M

	sbset       #0x05
	lri         $AR1, #COMMAND_HEADER_H
	lrri        $AC0.M, @$AR0
	andcf       $AC0.M, #0x8000
	jlz         loc_06c9
	mrr         $AX0.H, $AC0.M
	tstaxh      $AX0.H
	jz          loc_06cd
	bloop       $AX0.H, loc_06be
	lrri        $AC0.M, @$AR0
	srri        @$AR1, $AC0.M
	lrri        $AC0.M, @$AR0

loc_06be:
	srri        @$AR1, $AC0.M
	sr          @COMMAND_QUEUE_READ_POINTER, $AR0
	lri         $WR0, #0xffff
	jmp         dispatch_command

loc_06c5:
	lri         $WR0, #0xffff
	jmp         command_loop

loc_06c9:
	sr          @COMMAND_QUEUE_READ_POINTER, $AR0
	jmp         loc_06a1

loc_06cd:
	lri         $AR0, #read_command_queue
	jmp         yield_task

; 06D1: Buffered AFC: copy retained samples and update position.
copy_afc_retained_samples:
	lri         $AC0.M, #VOICE_AFC_DECODED_SAMPLES
	lrs         $AX0.H, @VOICE_AFC_DECODED_SAMPLE_INDEX_SHORT
	addr        $ACC0, $AX0.H
	mrr         $AR0, $AC0.M
	mrr         $AC0.M, $AX0.H
	not         $AC0.M
	incm        $AC0.M
	lrs         $AX0.H, @VOICE_AFC_DECODED_SAMPLE_COUNT_SHORT
	addr        $ACC0, $AX0.H
	lri         $AC0.H, #0x0000
	jmp         loc_06ee

copy_afc_retained_samples_bounded:
	lri         $AC0.M, #VOICE_AFC_DECODED_SAMPLES
	lrs         $AX0.H, @VOICE_AFC_DECODED_SAMPLE_INDEX_SHORT
	addr        $ACC0, $AX0.H
	mrr         $AR0, $AC0.M
	mrr         $AC0.M, $AX0.H
	not         $AC0.M
	incm        $AC0.M
	lrs         $AX0.H, @VOICE_AFC_DECODED_SAMPLE_COUNT_SHORT
	addr        $ACC0, $AX0.H
	lri         $AC0.H, #0x0000
	cmp
	ifge
	mrr         $AC0.M, $AC1.M

loc_06ee:
	mrr         $AX1.L, $AC0.M
	call        copy_sample_run
	lrs         $AC0.M, @VOICE_SOURCE_POSITION_H_SHORT
	lrs         $AC0.L, @VOICE_SOURCE_POSITION_L_SHORT
	addaxl      $ACC0, $AX1.L
	subr        $ACC1, $AX1.L
	srs         @VOICE_SOURCE_POSITION_H_SHORT, $AC0.M
	srs         @VOICE_SOURCE_POSITION_L_SHORT, $AC0.L
	ret

; 06F8: Compute AFC block address, within-block index and remaining sample count.
compute_afc_position:
	clr         $ACC0
	lrs         $AX0.H, @VOICE_SOURCE_POSITION_H_SHORT
	lrs         $AX0.L, @VOICE_SOURCE_POSITION_L_SHORT
	addax       $ACC0, $AX0
	lsr         $ACC0, #-4
	srs         @DATA_0436_SHORT, $AC0.M
	srs         @DATA_0437_SHORT, $AC0.L
	lrs         $AX1.H, @VOICE_SOURCE_TYPE_SHORT
	set15
	mulc'mv     $AC0.M, $AX1.H : $AX0.L, $AC0.L
	mulxmv      $AX0.L, $AX1.H, $ACC0
	clr15
	lrs         $AX0.L, @VOICE_SOURCE_POSITION_L_SHORT
	lsl16       $ACC0
	addp        $ACC0
	lrs         $AX1.H, @VOICE_BASE_ADDRESS_H_SHORT
	lrs         $AX1.L, @VOICE_BASE_ADDRESS_L_SHORT
	addax       $ACC0, $AX1
	srs         @VOICE_ARAM_ADDRESS_H_SHORT, $AC0.M
	srs         @VOICE_ARAM_ADDRESS_L_SHORT, $AC0.L
	mrr         $AC0.M, $AX0.L
	andi        $AC0.M, #0x000f
	srs         @VOICE_AFC_DECODED_SAMPLE_INDEX_SHORT, $AC0.M
	lrs         $AC0.M, @VOICE_LOOP_END_POSITION_H_SHORT
	lrs         $AC0.L, @VOICE_LOOP_END_POSITION_L_SHORT
	subax       $ACC0, $AX0
	srs         @VOICE_REMAINING_LENGTH_H_SHORT, $AC0.M
	srs         @VOICE_REMAINING_LENGTH_L_SHORT, $AC0.L
	ret

; 0716: AFC end/loop handling; restore loop predictor history, or mark done and zero-fill.
handle_afc_block_boundary:
	clr         $ACC0
	lrs         $AC0.M, @VOICE_DONE_SHORT
	tst         $ACC0
	jnz         loc_074f
	lrs         $AX0.H, @DATA_0436_SHORT
	lrs         $AX0.L, @DATA_0437_SHORT
	clr         $ACC0
	lrs         $AC0.M, @VOICE_LOOP_END_POSITION_H_SHORT
	lrs         $AC0.L, @VOICE_LOOP_END_POSITION_L_SHORT
	lsr         $ACC0, #-4
	subax       $ACC0, $AX0
	jz          loc_072b
	call        decode_afc_block
	lris        $AC0.M, #0x10

loc_0727:
	srs         @VOICE_AFC_DECODED_SAMPLE_COUNT_SHORT, $AC0.M
	clr         $ACC0
	srs         @VOICE_AFC_DECODED_SAMPLE_INDEX_SHORT, $AC0.M
	ret

loc_072b:
	lrs         $AX0.H, @VOICE_LOOP_END_POSITION_H_SHORT
	lrs         $AX0.L, @VOICE_LOOP_END_POSITION_L_SHORT
	clr         $ACC0
	lrs         $AC0.M, @VOICE_SOURCE_POSITION_H_SHORT
	lrs         $AC0.L, @VOICE_SOURCE_POSITION_L_SHORT
	subax       $ACC0, $AX0
	jge         loc_0738
	call        decode_afc_block
	lrs         $AC0.M, @VOICE_REMAINING_LENGTH_L_SHORT
	jmp         loc_0727

loc_0738:
	clr         $ACC0
	lrs         $AC0.M, @VOICE_LOOP_ENABLED_SHORT
	tst         $ACC0
	jz          loc_0750
	lrs         $AC0.M, @VOICE_LOOP_ADDRESS_H_SHORT
	lrs         $AC0.L, @VOICE_LOOP_ADDRESS_L_SHORT
	srs         @VOICE_SOURCE_POSITION_H_SHORT, $AC0.M
	srs         @VOICE_SOURCE_POSITION_L_SHORT, $AC0.L
	lris        $AC0.M, #0x10
	srs         @VOICE_AFC_DECODED_SAMPLE_COUNT_SHORT, $AC0.M
	call        compute_afc_position
	lrs         $AC0.M, @VOICE_LOOP_HISTORY_NEWER_SHORT
	srs         @VOICE_AFC_HISTORY_NEWER_SHORT, $AC0.M
	lrs         $AC0.M, @VOICE_LOOP_HISTORY_OLDER_SHORT
	srs         @VOICE_AFC_HISTORY_OLDER_SHORT, $AC0.M
	clr         $ACC0
	sr          @DATA_0362, $AC0.M
	call        decode_afc_block
	ret

loc_074f:
	clr         $ACC0

loc_0750:
	lri         $AR1, #VOICE_AFC_DECODED_SAMPLES
	loopi       #0x10
	srri        @$AR1, $AC0.M
	incm        $AC0.M
	srs         @VOICE_DONE_SHORT, $AC0.M
	lris        $AC0.M, #0x10
	srs         @VOICE_AFC_DECODED_SAMPLE_COUNT_SHORT, $AC0.M
	clr         $ACC0
	srs         @VOICE_AFC_DECODED_SAMPLE_INDEX_SHORT, $AC0.M
	ret

; 075B: Copy a bounded run of samples to output scratch.
copy_sample_run:
	tst         $ACC0
	retz
	addis       $AC0.M, #0xfe
	mrr         $AX0.L, $AC0.M
	lrri        $AC0.M, @$AR0
	jl          loc_0766
	lrri        $AX0.H, @$AR0
	loop        $AX0.L
	movr'ls     $ACC0, $AX0.H : $AX0.H, $AC0.M
	movr's      $ACC0, $AX0.H : @$AR3, $AC0.M

loc_0766:
	srri        @$AR3, $AC0.M
	ret

; 0768: General AFC reader: decode 16-sample blocks and retain leftovers.
load_afc_buffered:
	lri         $CR, #0x0004
	call        compute_afc_position
	clr         $ACC0
	sr          @DATA_0362, $AC0.M

loc_076f:
	clr         $ACC0
	lrs         $AC0.M, @VOICE_REMAINING_LENGTH_H_SHORT
	lrs         $AC0.L, @VOICE_REMAINING_LENGTH_L_SHORT
	tst         $ACC0
	jnz         loc_0785
	call        handle_afc_block_boundary
	lrs         $AX0.H, @VOICE_AFC_DECODED_SAMPLE_INDEX_SHORT
	tstaxh      $AX0.H
	jnz         loc_0782
	call        copy_afc_retained_samples_bounded
	tst         $ACC1
	jz          loc_07ae
	call        compute_afc_position

loc_0782:
	clr         $ACC0
	lrs         $AC0.M, @VOICE_REMAINING_LENGTH_H_SHORT
	lrs         $AC0.L, @VOICE_REMAINING_LENGTH_L_SHORT

loc_0785:
	mrr         $AX0.L, $AC1.M
	lris        $AX0.H, #0x00
	subax       $ACC0, $AX0
	jge         loc_079b
	clr         $ACC0
	lrs         $AC0.M, @VOICE_AFC_DECODED_SAMPLE_INDEX_SHORT
	tst         $ACC0
	jnz         loc_0795
	call        handle_afc_block_boundary
	lrs         $AX0.H, @VOICE_DONE_SHORT
	tstaxh      $AX0.H
	jnz         loc_07ab

loc_0795:
	call        copy_afc_retained_samples
	call        compute_afc_position
	jmp         loc_076f

loc_079b:
	clr         $ACC0
	lrs         $AC0.M, @VOICE_AFC_DECODED_SAMPLE_INDEX_SHORT
	tst         $ACC0
	jnz         loc_07a2
	call        handle_afc_block_boundary

loc_07a2:
	call        copy_afc_retained_samples_bounded
	tst         $ACC1
	jz          loc_07ae
	call        compute_afc_position
	jmp         loc_079b

loc_07ab:
	clr         $ACC0
	loop        $AC1.M
	srri        @$AR3, $AC0.M

loc_07ae:
	lri         $CR, #0x00ff
	ret

; 07B1: Decode one 5-byte (LQ) or 9-byte (HQ) AFC block.
decode_afc_block:
	sr          @DATA_0360, $AC1.M
	lr          $AX0.H, @DATA_0362
	tstaxh      $AX0.H
	jnz         loc_07c2
	lris        $AX0.H, #0x01
	sr          @DATA_0362, $AX0.H
	lrs         $AC0.M, @VOICE_ARAM_ADDRESS_H_SHORT
	lrs         $AC0.L, @VOICE_ARAM_ADDRESS_L_SHORT
	lris        $AC1.M, #0x05
	call        configure_sample_accelerator
	lri         $CR, #0x0004

loc_07c2:
	lri         $AR0, #ACCEL_RAW_DATA
	lri         $IX0, #0x0000

; 07C6: AFC header: upper nibble exponent, lower nibble predictor coefficient pair.
	lrrn        $AC0.M, @$AR0
	mrr         $AC1.M, $AC0.M
	lsl         $ACC0, #1
	andi        $AC0.M, #0x001e
	addi        $AC0.M, #AFC_COEFFICIENTS
	mrr         $AR1, $AC0.M
	lsr         $ACC1, #-4
	andi        $AC1.M, #0x000f
	lris        $AX0.H, #0x11
	subr        $ACC1, $AX0.H
	clr         $ACC0
	lrs         $AC0.M, @VOICE_SOURCE_TYPE_SHORT
	cmpis       $AC0.M, #0x05
	jz          unpack_afc_lq

; 07D8: HQ: unpack sixteen signed 4-bit residuals.
	lri         $AX0.H, #0x00f0
	lris        $AX1.H, #0x0f
	lri         $AR2, #AFC_RESIDUAL_SCRATCH
	lrrn        $AX0.L, @$AR0
	movr        $ACC0, $AX0.L
	bloopi      #0x07, loc_07e6
	andr        $AC0.M, $AX0.H
	lsl         $ACC0, #8
	movr's      $ACC0, $AX0.L : @$AR2, $AC0.M
	andr'ln     $AC0.M, $AX1.H : $AX0.L, @$AR0
	lsl         $ACC0, #12

loc_07e6:
	movr's      $ACC0, $AX0.L : @$AR2, $AC0.M
	andr        $AC0.M, $AX0.H
	lsl         $ACC0, #8
	movr's      $ACC0, $AX0.L : @$AR2, $AC0.M
	andr        $AC0.M, $AX1.H
	lsl         $ACC0, #12
	srri        @$AR2, $AC0.M
	jmp         apply_afc_predictor

; 07EF: LQ: unpack sixteen signed 2-bit residuals.
unpack_afc_lq:
	lri         $AX0.H, #0xc000
	lri         $AR2, #AFC_RESIDUAL_SCRATCH
	lrrn        $AX0.L, @$AR0
	movr        $ACC0, $AX0.L
	bloopi      #0x03, loc_0802
	lsl         $ACC0, #8
	andr        $AC0.M, $AX0.H
	movr's      $ACC0, $AX0.L : @$AR2, $AC0.M
	lsl         $ACC0, #10
	andr        $AC0.M, $AX0.H
	movr's      $ACC0, $AX0.L : @$AR2, $AC0.M
	lsl         $ACC0, #12
	andr        $AC0.M, $AX0.H
	movr's      $ACC0, $AX0.L : @$AR2, $AC0.M
	lsl         $ACC0, #14
	andr'ln     $AC0.M, $AX0.H : $AX0.L, @$AR0

loc_0802:
	movr's      $ACC0, $AX0.L : @$AR2, $AC0.M
	lsl         $ACC0, #8
	andr        $AC0.M, $AX0.H
	movr's      $ACC0, $AX0.L : @$AR2, $AC0.M
	lsl         $ACC0, #10
	andr        $AC0.M, $AX0.H
	movr's      $ACC0, $AX0.L : @$AR2, $AC0.M
	lsl         $ACC0, #12
	andr        $AC0.M, $AX0.H
	movr's      $ACC0, $AX0.L : @$AR2, $AC0.M
	lsl         $ACC0, #14
	andr        $AC0.M, $AX0.H
	srri        @$AR2, $AC0.M

; 080F: Two-history-sample predictor MAC loop; saturating stores in 40-bit mode.
apply_afc_predictor:
	set40
	mrr         $AX1.H, $AC1.M
	lrs         $AX0.L, @VOICE_AFC_HISTORY_OLDER_SHORT
	lrs         $AC1.M, @VOICE_AFC_HISTORY_NEWER_SHORT
	lrri        $AX0.H, @$AR1
	lrri        $AX1.L, @$AR1
	lri         $AR0, #AFC_RESIDUAL_SCRATCH
	lri         $AR1, #VOICE_AFC_DECODED_SAMPLES
	mrr         $IX0, $AR0
	mulx        $AX0.L, $AX1.L
	maddc'l     $AC1.M, $AX1.L : $AC0.M, @$AR0
	bloopi      #0x08, loc_0825
	asrnrx'mv   $ACC0, $AX1.H : $AX0.L, $AC1.M
	mulxac'l    $AX0.L, $AX1.L, $ACC0 : $AC1.M, @$AR0
	asl         $ACC0, #5
	maddc's     $AC0.M, $AX1.L : @$AR1, $AC0.M
	asrnrx'mv   $ACC1, $AX1.H : $AX0.L, $AC0.M
	mulxac'l    $AX0.L, $AX1.L, $ACC1 : $AC0.M, @$AR0
	asl         $ACC1, #5

loc_0825:
	maddc's     $AC1.M, $AX1.L : @$AR1, $AC1.M
	set16
	clr         $ACC1
	lr          $AC1.M, @DATA_0360
	ret

; 082B: Generated-waveform dispatcher; maintains phase at VPB byte 0060.
generate_waveform:
	clr         $ACC0
	mrr         $AX0.H, $AC0.M
	lr          $AX0.L, @VOICE_PITCH
	lr          $AC0.L, @VOICE_PHASE_FRACTION
	lri         $AR0, #VOICE_SAMPLE_BUFFER
	lr          $AC1.M, @VOICE_SOURCE_TYPE
	lsl         $ACC1, #1
	andi        $AC1.M, #0x007e
	addi        $AC1.M, #waveform_dispatch_table
	mrr         $AR2, $AC1.M
	callr       $AR2
	sr          @VOICE_PHASE_FRACTION, $AC0.L
	jmp         filter_voice

; 0840: 16-entry waveform dispatch table (JMP instructions).
waveform_dispatch_table:
	jmp         generate_square
	jmp         generate_saw
	jmp         generate_phase_modulated_square
	jmp         generate_quarter_duty_square
	jmp         generate_pattern_1
	jmp         waveform_return
	jmp         generate_constant
	jmp         generate_pattern_0
	jmp         waveform_return
	jmp         waveform_return
	jmp         generate_phase_modulated_pattern
	jmp         generate_pattern_2
	jmp         generate_pattern_3
	jmp         waveform_return
	jmp         waveform_return
	jmp         waveform_return

waveform_return:
	ret

; 0861: Source 00: square wave.
generate_square:
	lsl         $ACC0, #1
	lri         $AX1.H, #0xc000
	lri         $AX1.L, #0x4000
	bloopi      #0x50, loc_086e
	andcf       $AC0.M, #0x0001
	iflnz
	srri        @$AR0, $AX1.H
	iflz
	srri        @$AR0, $AX1.L

loc_086e:
	addax       $ACC0, $AX0
	lsr         $ACC0, #-1
	ret

; 0871: Source 03: quarter-duty square wave.
generate_quarter_duty_square:
	lsl         $ACC0, #2
	clr         $ACC1
	mrr         $AC1.L, $AX0.L
	lsl         $ACC1, #1
	lri         $AX1.H, #0xc000
	lri         $AX1.L, #0x4000
	bloopi      #0x50, loc_0881
	andcf       $AC0.M, #0x0003
	iflnz
	srri        @$AR0, $AX1.H
	iflz
	srri        @$AR0, $AX1.L

loc_0881:
	add         $ACC0, $ACC1
	lsr         $ACC0, #-2
	ret

; 0884: Source 02: square-wave variant using bus 0CA0 to update phase.
generate_phase_modulated_square:
	lsl         $ACC0, #1
	lri         $AR1, #BUS_REAR_RIGHT
	lri         $AX1.H, #0xc000
	lri         $AX1.L, #0x4000
	clr         $ACC1
	lri         $AR2, #0x0000
	bloopi      #0x50, loc_0899
	andcf       $AC0.M, #0x0001
	iflnz
	srri        @$AR0, $AX1.H
	iflz
	srri        @$AR0, $AX1.L
	lrr         $AC1.L, @$AR1
	addax       $ACC1, $AX0
	mrr         $AC1.M, $AR2

loc_0899:
	add's       $ACC0, $ACC1 : @$AR1, $AC1.M
	lsr         $ACC0, #-1
	ret

; 089C: Source 01: saw wave.
generate_saw:
	clr         $ACC1
	mrr         $AC1.L, $AX0.L
	lsr         $ACC1, #-1
	loopi       #0x50
	add's       $ACC0, $ACC1 : @$AR0, $AC0.L
	ret

; 08A2: Sources 0B/0C: evolving 64-word patterns 0180/01C0.
generate_pattern_2:
	lri         $AR2, #WAVEFORM_PATTERN_2
	jmp         generate_pattern_common

generate_pattern_3:
	lri         $AR2, #WAVEFORM_PATTERN_3
	jmp         generate_pattern_common

; 08AA: Source 04: table at 0140.
generate_pattern_1:
	lri         $AR2, #WAVEFORM_PATTERN_1

generate_pattern_common:
	lri         $WR2, #0x003f
	lri         $IX2, #0x0000
	lsl         $ACC0, #6
	clr         $ACC1
	mrr         $AC1.L, $AX0.L
	lsl         $ACC1, #5
	lri         $AX1.H, #0x003f
	lri         $AX0.H, #0x0000
	andr        $AC0.M, $AX1.H
	mrr         $IX2, $AC0.M
	addarn      $AR2, $IX2
	andr        $AC0.M, $AX0.H
	bloopi      #0x50, loc_08c2
	add'l       $ACC0, $ACC1 : $AX1.L, @$AR2
	andr'dr     $AC0.M, $AX1.H : $AR2
	mrr         $IX2, $AC0.M
	andr'nr     $AC0.M, $AX0.H : $AR2

loc_08c2:
	srri        @$AR0, $AX1.L
	mrr         $AC0.M, $AR2
	lsr         $ACC0, #-6
	lri         $WR2, #0xffff
	ret

; 08C8: Source 06: fill with pitch word (constant generator).
generate_constant:
	loopi       #0x50
	srri        @$AR0, $AX0.L
	ret

; 08CB: Source 07: table at 0100.
generate_pattern_0:
	lri         $AR2, #WAVEFORM_PATTERN_0
	lri         $WR2, #0x003f
	lri         $IX2, #0x0000
	lsl         $ACC0, #6
	clr         $ACC1
	mrr         $AC1.L, $AX0.L
	lsl         $ACC1, #5
	lri         $AX1.H, #0x003f
	lri         $AX0.H, #0x0000
	andr        $AC0.M, $AX1.H
	mrr         $IX2, $AC0.M
	addarn      $AR2, $IX2
	andr        $AC0.M, $AX0.H
	bloopi      #0x50, loc_08e3
	add'l       $ACC0, $ACC1 : $AX1.L, @$AR2
	andr'dr     $AC0.M, $AX1.H : $AR2
	mrr         $IX2, $AC0.M
	andr'nr     $AC0.M, $AX0.H : $AR2

loc_08e3:
	srri        @$AR0, $AX1.L
	mrr         $AC0.M, $AR2
	lsr         $ACC0, #-6
	lri         $WR2, #0xffff
	ret

; 08E9: Source 0A: table at 0100 with phase modulation from bus 0CA0.
generate_phase_modulated_pattern:
	lri         $AR2, #WAVEFORM_PATTERN_0
	lri         $WR2, #0x003f
	lri         $IX2, #0x0000
	lri         $AR1, #BUS_REAR_RIGHT
	lsl         $ACC0, #6
	clr         $ACC1
	mrr         $AC1.L, $AX0.L
	lsl         $ACC1, #5
	lri         $AX1.H, #0x003f
	lri         $AX0.H, #0x0000
	andr        $AC0.M, $AX1.H
	mrr         $IX2, $AC0.M
	addarn      $AR2, $IX2
	andr        $AC0.M, $AX0.H
	bloopi      #0x50, loc_0908
	lrri        $AX1.L, @$AR1
	mulx        $AX0.L, $AX1.L
	lsl         $ACC0, #10
	addp        $ACC0
	lsr         $ACC0, #-10
	add'l       $ACC0, $ACC1 : $AX1.L, @$AR2
	andr'dr     $AC0.M, $AX1.H : $AR2
	mrr         $IX2, $AC0.M
	andr'nr     $AC0.M, $AX0.H : $AR2

loc_0908:
	srri        @$AR0, $AX1.L
	mrr         $AC0.M, $AR2
	lsr         $ACC0, #-6
	lri         $WR2, #0xffff
	ret

; 090E: Update two evolving waveform patterns once per block.
update_waveform_patterns:
	lri         $AR0, #WAVEFORM_PATTERN_2_HISTORY
	lrri        $AX0.L, @$AR0
	lrri        $AX0.H, @$AR0
	lri         $AR0, #WAVEFORM_PATTERN_2
	lri         $AR3, #WAVEFORM_PATTERN_2
	mul'l       $AX0.L, $AX0.H : $AC0.M, @$AR0
	mrr         $AC1.M, $AC0.M
	bloopi      #0x20, loc_091f
	neg         $ACC0
	mulcac'l    $AC1.M, $AX0.H, $ACC0 : $AX0.H, @$AR0
	movr's      $ACC1, $AX0.H : @$AR3, $AC0.M
	mulcac'l    $AC0.M, $AX0.H, $ACC1 : $AX0.H, @$AR0
	lsl         $ACC1, #1

loc_091f:
	movr's      $ACC0, $AX0.H : @$AR3, $AC1.M
	lri         $AR0, #WAVEFORM_PATTERN_3_HISTORY
	lrri        $AX0.H, @$AR0
	lrri        $AX0.L, @$AR0
	lri         $AR0, #WAVEFORM_PATTERN_3
	lri         $AR3, #WAVEFORM_PATTERN_3
	mrr         $AC1.M, $AX0.L
	mul'l       $AX0.L, $AX0.H : $AC0.M, @$AR0
	addpaxz     $ACC0, $AX0
	andi        $AC0.M, #0x01ff
	ori         $AC0.M, #0x2000
	call        fill_evolving_pattern
	ret

fill_evolving_pattern:
	tst         $ACC1
	ifg
	neg         $ACC0
	mrr         $AX1.H, $AC0.M
	addr        $ACC1, $AX1.H
	bloopi      #0x10, loc_093c
	addr's      $ACC1, $AX1.H : @$AR3, $AC1.M
	addr's      $ACC1, $AX1.H : @$AR3, $AC1.M
	addr's      $ACC1, $AX1.H : @$AR3, $AC1.M

loc_093c:
	addr's      $ACC1, $AX1.H : @$AR3, $AC1.M
	ret

; 093E: Source 08: signed PCM8 from ARAM, expand to signed PCM16, then resample.
load_pcm8_aram:
	lri         $CR, #0x0004
	lrs         $AX0.L, @VOICE_PITCH_SHORT
	clr         $ACC0
	clr         $ACC1
	lrs         $AC0.L, @VOICE_PHASE_FRACTION_SHORT
	set15
	lris        $AX1.L, #0x50
	mulx        $AX0.L, $AX1.L
	mulxac      $AX0.L, $AX1.L, $ACC0
	lsl         $ACC0, #4
	clr15
	mrr         $AC1.M, $AC0.M
	lri         $AR3, #RAW_SAMPLE_BUFFER
	lrs         $AX0.H, @VOICE_DONE_SHORT
	tstaxh      $AX0.H
	jnz         loc_0960
	lrs         $AX0.H, @VOICE_RESET_SHORT
	tstaxh      $AX0.H
	callnz      reset_pcm8_position
	clr         $ACC0
	lrs         $AC0.M, @VOICE_END_REACHED_SHORT
	tst         $ACC0
	jz          loc_096d

loc_095a:
	clr         $ACC0
	srs         @VOICE_END_REACHED_SHORT, $AC0.M
	lrs         $AX0.H, @VOICE_LOOP_ENABLED_SHORT
	tstaxh      $AX0.H
	jnz         loc_0967

loc_0960:
	clr         $ACC0
	loop        $AC1.M
	srri        @$AR3, $AC0.M
	incm        $AC0.M
	srs         @VOICE_DONE_SHORT, $AC0.M
	jmp         loc_09a3

loc_0967:
	lrs         $AC0.M, @VOICE_LOOP_ADDRESS_H_SHORT
