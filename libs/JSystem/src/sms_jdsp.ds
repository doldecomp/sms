; 09C5: Source 10: signed PCM16 from ARAM, then resample.
load_pcm16_aram:
	lri         $CR, #0x0004
	lrs         $AX0.L, @VOICE_PITCH_SHORT
	clr         $ACC0
	clr         $ACC1
	lrs         $AC0.L, @VOICE_PHASE_FRACTION_SHORT
	set15
	lris        $AX1.L, #0x50
	mulx        $AX0.L, $AX1.L
	mulxac      $AX0.L, $AX1.L, $ACC0
	lsl         $ACC0, #4
	clr15
	mrr         $AC1.M, $AC0.M
	lri         $AR3, #RAW_SAMPLE_BUFFER
	lrs         $AX0.H, @VOICE_DONE_SHORT
	tstaxh      $AX0.H
	jnz         loc_09e7
	lrs         $AX0.H, @VOICE_RESET_SHORT
	tstaxh      $AX0.H
	callnz      reset_pcm16_position
	clr         $ACC0
	lrs         $AC0.M, @VOICE_END_REACHED_SHORT
	tst         $ACC0
	jz          loc_09f4

loc_09e1:
	clr         $ACC0
	srs         @VOICE_END_REACHED_SHORT, $AC0.M
	lrs         $AX0.H, @VOICE_LOOP_ENABLED_SHORT
	tstaxh      $AX0.H
	jnz         loc_09ee

loc_09e7:
	clr         $ACC0
	loop        $AC1.M
	srri        @$AR3, $AC0.M
	incm        $AC0.M
	srs         @VOICE_DONE_SHORT, $AC0.M
	jmp         loc_0a2b

loc_09ee:
	lrs         $AC0.M, @VOICE_LOOP_ADDRESS_H_SHORT
	lrs         $AC0.L, @VOICE_LOOP_ADDRESS_L_SHORT
