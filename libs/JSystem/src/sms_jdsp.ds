; 0A44: PCM16 read loop through raw accelerator port FFD3.
read_pcm16_samples:
	lri         $AR0, #ACCEL_RAW_DATA
	lri         $IX0, #0x0000
	bloop       $AX0.H, loc_0a4b
	lrrn        $AC0.M, @$AR0

loc_0a4b:
	srri        @$AR3, $AC0.M
	ret

; 0A4D: Source 20: MRAM PCM16 directly into 80-sample voice buffer; no resampling.
load_pcm16_mram_direct:
	clr         $ACC1
	lris        $AC1.M, #0x50
	lri         $AR3, #VOICE_SAMPLE_BUFFER
	call        load_pcm16_mram_common
