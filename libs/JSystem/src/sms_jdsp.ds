loc_09a3:
	lri         $CR, #0x00ff
	jmp         resample_voice

reset_pcm8_position:
	clr         $ACC0
	srs         @VOICE_SOURCE_POSITION_H_SHORT, $AC0.M
	srs         @VOICE_SOURCE_POSITION_L_SHORT, $AC0.M

compute_pcm8_position:
