; 0A66: MRAM PCM end/loop handling.
load_pcm16_mram_common:
	lri         $CR, #0x0004
	clr         $ACC0
	lrs         $AC0.M, @VOICE_REMAINING_LENGTH_H_SHORT
	lrs         $AC0.L, @VOICE_REMAINING_LENGTH_L_SHORT
	mrr         $AX0.L, $AC1.M
	lris        $AX0.H, #0x00
	subax       $ACC0, $AX0
	jge         loc_0a84
	clr         $ACC1
	lr          $AR0, @VOICE_REMAINING_LENGTH_L
	call        dma_pcm16_samples
	clr         $ACC0
	mrr         $AC0.M, $AX0.L
	lrs         $AX0.H, @VOICE_REMAINING_LENGTH_L_SHORT
	subr        $ACC0, $AX0.H
	dar         $AR3
	lrri        $AX1.L, @$AR3
	loop        $AC0.M
	srri        @$AR3, $AX1.L
	lris        $AC1.M, #0x01
	srs         @VOICE_DONE_SHORT, $AC1.M
	clr         $ACC1
	srs         @VOICE_REMAINING_LENGTH_L_SHORT, $AC1.M
	lri         $CR, #0x00ff
	ret

loc_0a84:
	srs         @VOICE_REMAINING_LENGTH_H_SHORT, $AC0.M
	srs         @VOICE_REMAINING_LENGTH_L_SHORT, $AC0.L
	clr         $ACC0
	clr         $ACC1
	lrs         $AC0.M, @VOICE_LOOP_END_POSITION_H_SHORT
	lrs         $AC1.M, @VOICE_SOURCE_POSITION_H_SHORT
	sub         $ACC0, $ACC1
	srs         @DATA_0436_SHORT, $AC0.M
	subr        $ACC0, $AX0.L
	jge         loc_0aa3
	lr          $AR0, @DATA_0436
	call        dma_pcm16_samples
	clr         $ACC0
	mrr         $AC0.M, $AX0.L
	lrs         $AX0.H, @DATA_0436_SHORT
	subr        $ACC0, $AX0.H
	mrr         $AR0, $AC0.M
	clr         $ACC0
	srs         @VOICE_SOURCE_POSITION_H_SHORT, $AC0.M
	lrs         $AC0.M, @VOICE_LOOP_ADDRESS_H_SHORT
	lrs         $AC0.L, @VOICE_LOOP_ADDRESS_L_SHORT
