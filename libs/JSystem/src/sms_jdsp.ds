	srs         @VOICE_BASE_ADDRESS_L_SHORT, $AC0.L
	call        dma_pcm16_samples
	lri         $CR, #0x00ff
	ret

loc_0aa3:
	mrr         $AR0, $AX0.L
	call        dma_pcm16_samples
	lri         $CR, #0x00ff
	ret

; 0AA9: Aligned MRAM DMA to temporary 0B00, copy requested samples to voice/raw scratch.
dma_pcm16_samples:
	clr         $ACC0
	mrr         $AC0.M, $AR0
	tst         $ACC0
	retz
	clr         $ACC1
	lrs         $AC1.M, @VOICE_SOURCE_POSITION_H_SHORT
	andi        $AC1.M, #0x0001
	lris        $AX1.H, #0x00
	mrr         $AX1.L, $AC1.M
	lrs         $AC0.M, @VOICE_BASE_ADDRESS_H_SHORT
	lrs         $AC0.L, @VOICE_BASE_ADDRESS_L_SHORT
	clr         $ACC1
	lrs         $AC1.L, @VOICE_SOURCE_POSITION_H_SHORT
	lsl         $ACC1, #1
	add         $ACC0, $ACC1
	subax       $ACC0, $AX1
	subax       $ACC0, $AX1
	mrr         $AR1, $AR0
	mrr         $AC1.M, $AR0
	addis       $AC1.M, #0x02
	mrr         $AR0, $AC1.M
	lri         $AC1.M, #SHARED_SAMPLE_GAIN_SCRATCH
	lri         $CR, #0x00ff
	call        dma_read
	lri         $CR, #0x0004
	lrs         $AC1.M, @VOICE_SOURCE_POSITION_H_SHORT
	mrr         $AX1.H, $AR1
	addr        $ACC1, $AX1.H
	srs         @VOICE_SOURCE_POSITION_H_SHORT, $AC1.M
	lri         $AR0, #SHARED_SAMPLE_GAIN_SCRATCH
	clr         $ACC1
	mrr         $AC1.M, $AX1.L
	tst         $ACC1
	ifnz
	iar         $AR0
	clr         $ACC1
	mrr         $AC1.M, $AR1
	lrri        $AC0.M, @$AR0
	cmpis       $AC1.M, #0x01
	jle         loc_0adf
	lrri        $AX0.H, @$AR0
	addis       $AC1.M, #0xfe
	loop        $AC1.M
	movr'ls     $ACC0, $AX0.H : $AX0.H, $AC0.M
	srri        @$AR3, $AC0.M
	srri        @$AR3, $AX0.H
	ret

loc_0adf:
	srri        @$AR3, $AC0.M
	ret

; 0AE1: Fast aligned HQ AFC source with accelerator byte reads.
load_afc_hq_aligned:
	lri         $CR, #0x0004
	lrs         $AX0.H, @VOICE_DONE_SHORT
	tstaxh      $AX0.H
	jnz         loc_0b12
	lrs         $AX0.H, @VOICE_RESET_SHORT
	tstaxh      $AX0.H
	callnz      reset_afc_hq_position
	lrs         $AX0.H, @VOICE_AFC_DECODED_SAMPLE_INDEX_SHORT
	tstaxh      $AX0.H
	jz          loc_0b07
	lri         $AC0.M, #VOICE_AFC_DECODED_SAMPLES
	addr        $ACC0, $AX0.H
	mrr         $AR0, $AC0.M
	lris        $AC0.M, #0x10
	subr        $ACC0, $AX0.H
	mrr         $AX1.H, $AC0.M
	call        copy_sample_run
	cmpaxh      $ACC1, $AX1.H
	jg          loc_0b06
	jz          loc_0b02
	lrs         $AC0.M, @VOICE_AFC_DECODED_SAMPLE_INDEX_SHORT
	add         $ACC0, $ACC1
	srs         @VOICE_AFC_DECODED_SAMPLE_INDEX_SHORT, $AC0.M
	jmp         loc_0b62

loc_0b02:
	clr         $ACC0
	srs         @VOICE_AFC_DECODED_SAMPLE_INDEX_SHORT, $AC0.M
	jmp         loc_0b62

loc_0b06:
	subr        $ACC1, $AX1.H

loc_0b07:
	clr         $ACC0
	lrs         $AC0.M, @VOICE_END_REACHED_SHORT
	tst         $ACC0
	jz          loc_0b23

loc_0b0c:
	clr         $ACC0
	srs         @VOICE_END_REACHED_SHORT, $AC0.M
	lrs         $AX0.H, @VOICE_LOOP_ENABLED_SHORT
	tstaxh      $AX0.H
	jnz         loc_0b19

loc_0b12:
	clr         $ACC0
	loop        $AC1.M
	srri        @$AR3, $AC0.M
	incm        $AC0.M
	srs         @VOICE_DONE_SHORT, $AC0.M
	jmp         loc_0b62

loc_0b19:
	lrs         $AC0.M, @VOICE_LOOP_ADDRESS_H_SHORT
	lrs         $AC0.L, @VOICE_LOOP_ADDRESS_L_SHORT
	srs         @VOICE_SOURCE_POSITION_H_SHORT, $AC0.M
	srs         @VOICE_SOURCE_POSITION_L_SHORT, $AC0.L
	call        compute_afc_hq_position
	lrs         $AC0.M, @VOICE_LOOP_HISTORY_NEWER_SHORT
	lrs         $AC0.L, @VOICE_LOOP_HISTORY_OLDER_SHORT
	srs         @VOICE_AFC_HISTORY_NEWER_SHORT, $AC0.M
	srs         @VOICE_AFC_HISTORY_OLDER_SHORT, $AC0.L

loc_0b23:
	sr          @DATA_0360, $AC1.M
	lrs         $AC0.M, @VOICE_ARAM_ADDRESS_H_SHORT
	lrs         $AC0.L, @VOICE_ARAM_ADDRESS_L_SHORT
	lris        $AC1.M, #0x05
	call        configure_sample_accelerator
	lri         $CR, #0x0004
	clr         $ACC1
	sr          @DATA_0362, $AC1.M
	lr          $AC1.M, @DATA_0360

loc_0b31:
	call        decode_afc_hq_block
	clr         $ACC0
	lr          $AC0.M, @DATA_0362
	lrs         $AX0.H, @VOICE_SOURCE_TYPE_SHORT
	addr        $ACC0, $AX0.H
	sr          @DATA_0362, $AC0.M
	clr         $ACC0
	lrs         $AC0.M, @VOICE_REMAINING_LENGTH_H_SHORT
	lrs         $AC0.L, @VOICE_REMAINING_LENGTH_L_SHORT
	lris        $AX0.H, #0x01
	lri         $AR1, #VOICE_END_REACHED
	dec         $ACC0
	tst         $ACC0
	ifz
	srr         @$AR1, $AX0.H
	srs         @VOICE_REMAINING_LENGTH_H_SHORT, $AC0.M
	srs         @VOICE_REMAINING_LENGTH_L_SHORT, $AC0.L
	cmpis       $AC1.M, #0x10
	jle         loc_0b50
	addis       $AC1.M, #0xf0
	lrs         $AX0.H, @VOICE_END_REACHED_SHORT
	tstaxh      $AX0.H
	jnz         loc_0b0c
	jmp         loc_0b31

loc_0b50:
	ifz
	clr         $ACC1
	srs         @VOICE_AFC_DECODED_SAMPLE_INDEX_SHORT, $AC1.M
	mrr         $AC0.M, $AR3
	addis       $AC0.M, #0xf0
	mrr         $AR0, $AC0.M
	lri         $AR3, #VOICE_AFC_DECODED_SAMPLES
	lris        $AC0.M, #0x10
	call        copy_sample_run
	lrs         $AC0.M, @VOICE_ARAM_ADDRESS_H_SHORT
	lrs         $AC0.L, @VOICE_ARAM_ADDRESS_L_SHORT
	lr          $AX0.L, @DATA_0362
	addaxl      $ACC0, $AX0.L
	srs         @VOICE_ARAM_ADDRESS_L_SHORT, $AC0.L
	srs         @VOICE_ARAM_ADDRESS_H_SHORT, $AC0.M

loc_0b62:
	lri         $CR, #0x00ff
	ret

reset_afc_hq_position:
	clr         $ACC0
	srs         @VOICE_SOURCE_POSITION_H_SHORT, $AC0.M
	srs         @VOICE_SOURCE_POSITION_L_SHORT, $AC0.M
	srs         @VOICE_AFC_HISTORY_OLDER_SHORT, $AC0.M
	srs         @VOICE_AFC_HISTORY_NEWER_SHORT, $AC0.M

compute_afc_hq_position:
	lrs         $AX1.H, @VOICE_SOURCE_POSITION_H_SHORT
	lrs         $AX1.L, @VOICE_SOURCE_POSITION_L_SHORT
	lrs         $AC0.M, @VOICE_LOOP_END_POSITION_H_SHORT
	lrs         $AC0.L, @VOICE_LOOP_END_POSITION_L_SHORT
	subax       $ACC0, $AX1
	lsr         $ACC0, #-4
	srs         @VOICE_REMAINING_LENGTH_H_SHORT, $AC0.M
	srs         @VOICE_REMAINING_LENGTH_L_SHORT, $AC0.L
	lrs         $AC0.M, @VOICE_SOURCE_POSITION_H_SHORT
	lrs         $AC0.L, @VOICE_SOURCE_POSITION_L_SHORT
	lsr         $ACC0, #-4
	lrs         $AX0.H, @VOICE_SOURCE_TYPE_SHORT
	mulc'mv     $AC0.M, $AX0.H : $AX0.L, $AC0.L
	mulmv       $AX0.L, $AX0.H, $ACC0
	lsl16       $ACC0
	addp        $ACC0
	lrs         $AX1.H, @VOICE_BASE_ADDRESS_H_SHORT
	lrs         $AX1.L, @VOICE_BASE_ADDRESS_L_SHORT
	addax       $ACC0, $AX1
	srs         @VOICE_ARAM_ADDRESS_H_SHORT, $AC0.M
	srs         @VOICE_ARAM_ADDRESS_L_SHORT, $AC0.L
	clr         $ACC0
	srs         @VOICE_END_REACHED_SHORT, $AC0.M
	srs         @VOICE_AFC_DECODED_SAMPLE_INDEX_SHORT, $AC0.M
	ret

; 0B83: Fast HQ AFC block decoder (9 bytes -> 16 samples).
decode_afc_hq_block:
	sr          @DATA_0360, $AC1.M
	lri         $AR0, #ACCEL_RAW_DATA
	lri         $IX0, #0x0000
	lrrn        $AC0.M, @$AR0
	mrr         $AC1.M, $AC0.M
	lsl         $ACC0, #1
	andi        $AC0.M, #0x001e
	addi        $AC0.M, #AFC_COEFFICIENTS
	mrr         $AR1, $AC0.M
	lsr         $ACC1, #-4
	andi        $AC1.M, #0x000f
	lris        $AX0.H, #0x11
	subr        $ACC1, $AX0.H
	lri         $AX0.H, #0x00f0
	lris        $AX1.H, #0x0f
	lri         $AR2, #AFC_RESIDUAL_SCRATCH
	lrrn        $AX0.L, @$AR0
	movr        $ACC0, $AX0.L
	bloopi      #0x07, loc_0ba4
	andr        $AC0.M, $AX0.H
	lsl         $ACC0, #8
	movr's      $ACC0, $AX0.L : @$AR2, $AC0.M
	andr'ln     $AC0.M, $AX1.H : $AX0.L, @$AR0
	lsl         $ACC0, #12

loc_0ba4:
	movr's      $ACC0, $AX0.L : @$AR2, $AC0.M
	andr        $AC0.M, $AX0.H
	lsl         $ACC0, #8
	movr's      $ACC0, $AX0.L : @$AR2, $AC0.M
	andr        $AC0.M, $AX1.H
	lsl         $ACC0, #12
	srri        @$AR2, $AC0.M
	set40
	mrr         $AX1.H, $AC1.M
	lrs         $AX0.L, @VOICE_AFC_HISTORY_OLDER_SHORT
	lrs         $AC1.M, @VOICE_AFC_HISTORY_NEWER_SHORT
	lrri        $AX0.H, @$AR1
	lrri        $AX1.L, @$AR1
	lri         $AR0, #AFC_RESIDUAL_SCRATCH
	mrr         $IX0, $AR0
	mulx        $AX0.L, $AX1.L
	maddc'l     $AC1.M, $AX1.L : $AC0.M, @$AR0
	asrnrx'mv   $ACC0, $AX1.H : $AX0.L, $AC1.M
	mulxac'l    $AX0.L, $AX1.L, $ACC0 : $AC1.M, @$AR0
	asl         $ACC0, #5
	maddc's     $AC0.M, $AX1.L : @$AR3, $AC0.M
	asrnrx'mv   $ACC1, $AX1.H : $AX0.L, $AC0.M
	mulxac'l    $AX0.L, $AX1.L, $ACC1 : $AC0.M, @$AR0
	asl         $ACC1, #5
	maddc's     $AC1.M, $AX1.L : @$AR3, $AC1.M
	bloopi      #0x06, loc_0bc7
	asrnrx'mv   $ACC0, $AX1.H : $AX0.L, $AC1.M
	mulxac'l    $AX0.L, $AX1.L, $ACC0 : $AC1.M, @$AR0
	asl         $ACC0, #5
	maddc's     $AC0.M, $AX1.L : @$AR3, $AC0.M
	asrnrx'mv   $ACC1, $AX1.H : $AX0.L, $AC0.M
	mulxac'l    $AX0.L, $AX1.L, $ACC1 : $AC0.M, @$AR0
	asl         $ACC1, #5

loc_0bc7:
	maddc's     $AC1.M, $AX1.L : @$AR3, $AC1.M
	asrnrx'mv   $ACC0, $AX1.H : $AX0.L, $AC1.M
	mulxac'l    $AX0.L, $AX1.L, $ACC0 : $AC1.M, @$AR0
	asl         $ACC0, #5
	maddc's     $AC0.M, $AX1.L : @$AR3, $AC0.M
	asrnrx'mv   $ACC1, $AX1.H : $AX0.L, $AC0.M
	mulxac      $AX0.L, $AX1.L, $ACC1
	asl         $ACC1, #5
	srri        @$AR3, $AC1.M
	srs         @VOICE_AFC_HISTORY_OLDER_SHORT, $AC0.M
	srs         @VOICE_AFC_HISTORY_NEWER_SHORT, $AC1.M
	set16
	clr         $ACC1
	lr          $AC1.M, @DATA_0360
	ret

; 0BD7: 8-tap FIR used by effects-line preprocessing.
filter_fir8:
	m2
	lri         $AR3, #FILTER_COEFFICIENT_SCRATCH
	lrri        $AC0.M, @$AR0
	lrri        $AX0.H, @$AR0
	loopi       #0x06
	movr'ls     $ACC0, $AX0.H : $AX0.H, $AC0.M
	srri        @$AR3, $AC0.M
	srri        @$AR3, $AX0.H
	lri         $AR0, #FILTER_COEFFICIENT_SCRATCH
	lri         $WR0, #0x0007
	bloopi      #0x50, loc_0bf1
	mrr         $AR3, $AR1
	clrp'ldax   : $AX0, @$AR0
	madd'ldax   $AX0.L, $AX0.H : $AX0, @$AR0
	madd'ldax   $AX0.L, $AX0.H : $AX0, @$AR0
	madd'ldax   $AX0.L, $AX0.H : $AX0, @$AR0
	madd'ldax   $AX0.L, $AX0.H : $AX0, @$AR0
	madd'ldax   $AX0.L, $AX0.H : $AX0, @$AR0
	madd'ldax   $AX0.L, $AX0.H : $AX0, @$AR0
	madd'ldax   $AX0.L, $AX0.H : $AX0, @$AR0
	madd        $AX0.L, $AX0.H
	movpz       $ACC0

loc_0bf1:
	srri        @$AR1, $AC0.M
	lri         $WR0, #0xffff
	m0
	ret

; 0BF6: Variable-length FIR used by each voice.
filter_fir_variable:
	m2
	addis       $AC1.M, #0xfe
	lri         $AR3, #FILTER_COEFFICIENT_SCRATCH
	lrri        $AC0.M, @$AR0
	lrri        $AX0.H, @$AR0
	loop        $AC1.M
	movr'ls     $ACC0, $AX0.H : $AX0.H, $AC0.M
	srri        @$AR3, $AC0.M
	srri        @$AR3, $AX0.H
	lri         $AR0, #FILTER_COEFFICIENT_SCRATCH
	addis       $AC1.M, #0x01
	mrr         $WR0, $AC1.M
	bloopi      #0x50, loc_0c0c
	mrr         $AR3, $AR1
	clrp'ldax   : $AX0, @$AR0
	loop        $AC1.M
	madd'ldax   $AX0.L, $AX0.H : $AX0, @$AR0
	madd        $AX0.L, $AX0.H
	movpz       $ACC0

loc_0c0c:
	srri        @$AR1, $AC0.M
	lri         $WR0, #0xffff
	m0
	ret

; 0C11: Four-coefficient recursive filter; histories at caller-supplied AR2.
filter_recursive:
	lri         $AR3, #FILTER_COEFFICIENT_SCRATCH
	lrri        $AC0.M, @$AR0
	lrri        $AX0.H, @$AR0
	movr'ls     $ACC0, $AX0.H : $AX0.H, $AC0.M
	movr'ls     $ACC0, $AX0.H : $AX0.H, $AC0.M
	srri        @$AR3, $AC0.M
	srri        @$AR3, $AX0.H
	lri         $AR0, #FILTER_COEFFICIENT_SCRATCH
	lri         $WR0, #0x0003
	lri         $IX1, #0x0000
	lri         $IX3, #0x0000
	mrr         $AC0.M, $AR2
	lrri        $AX1.H, @$AR2
	lrri        $AX1.L, @$AR2
	lrri        $AC1.M, @$AR2
	lrri        $AX0.H, @$AR2
	mrr         $AR2, $AC0.M
	mrr         $AC0.M, $AX0.H
	mrr         $AR3, $AR1
	m2
	set40
	lrri        $AX0.H, @$AR0
	mulx'l      $AX0.H, $AX1.H : $AX0.H, @$AR0
	maddx'l     $AX0.H, $AX1.L : $AX0.H, @$AR0
	maddc'l     $AC1.M, $AX1.L : $AX0.H, @$AR0
	maddc'ldm   $AC0.M, $AX1.L : $AX0.H, $AX1.L, @$AR0
	mulxmv'l    $AX0.H, $AX1.L, $ACC0 : $AX0.H, @$AR0
	bloopi      #0x27, loc_0c3c
	maddx'lsm   $AX0.H, $AX1.H : $AX0.H, $AC0.M
	lrri        $AC0.M, @$AR3
	maddc'l     $AC0.M, $AX1.L : $AX0.H, @$AR0
	maddc'ldm   $AC1.M, $AX1.L : $AX0.H, $AX1.H, @$AR0
	mulxmv'l    $AX0.H, $AX1.H, $ACC1 : $AX0.H, @$AR0
	maddx'lsm   $AX0.H, $AX1.L : $AX0.H, $AC1.M
	lrri        $AC1.M, @$AR3
	maddc'l     $AC1.M, $AX1.L : $AX0.H, @$AR0
	maddc'ldm   $AC0.M, $AX1.L : $AX0.H, $AX1.L, @$AR0

loc_0c3c:
	mulxmv'l    $AX0.H, $AX1.L, $ACC0 : $AX0.H, @$AR0
	maddx'lsm   $AX0.H, $AX1.H : $AX0.H, $AC0.M
	lrri        $AC0.M, @$AR3
	maddc'l     $AC0.M, $AX1.L : $AX0.H, @$AR0
	maddc'ldm   $AC1.M, $AX1.L : $AX0.H, $AX1.H, @$AR0
	mulxmv      $AX0.H, $AX1.H, $ACC1
	srrn        @$AR3, $AC1.M
	lrri        $AC1.M, @$AR3
	set16
	m0
	lri         $WR0, #0xffff
	srri        @$AR2, $AX1.H
	srri        @$AR2, $AX1.L
	srri        @$AR2, $AC1.M
	srri        @$AR2, $AC0.M
	ret

; 0C4D: Initialize special delay/modulation state 03F0..03F7.
initialize_modulated_delay:
	lris        $AC0.M, #0xff
	sr          @MODULATED_DELAY_DIRECTION, $AC0.M
	clr         $ACC0
	sr          @MODULATED_DELAY_WRITE_OFFSET, $AC0.M
	sr          @MODULATED_DELAY_READ_FRACTION, $AC0.M
	lri         $AC0.M, #0x0100
	sr          @MODULATED_DELAY_STEP_DELTA, $AC0.M
	lr          $AX0.H, @MODULATED_DELAY_STEP_DELTA
	lri         $AC0.M, #0x8000
	subr        $ACC0, $AX0.H
	sr          @MODULATED_DELAY_READ_STEP, $AC0.M
	lris        $AC0.M, #0x30
	sr          @MODULATED_DELAY_THRESHOLD_0, $AC0.M
	lris        $AC0.M, #0x10
	sr          @MODULATED_DELAY_THRESHOLD_1, $AC0.M
	lri         $AC0.M, #0x0096
	sr          @MODULATED_DELAY_READ_OFFSET, $AC0.M
	ret

; 0C6B: Copy 80 samples from bus 0A00 into alternating halves of 160-word ring 0A60.
write_modulated_delay:
	lri         $AR0, #BUS_MODULATED_DELAY
	clr         $ACC0
	lr          $AC0.M, @MODULATED_DELAY_WRITE_OFFSET
	clr         $ACC1
	tst         $ACC0
	ifz
	addis       $AC1.M, #0x50
	sr          @MODULATED_DELAY_WRITE_OFFSET, $AC1.M
	addi        $AC0.M, #MODULATED_DELAY_RING
	mrr         $AR3, $AC0.M
	lris        $AC1.M, #0x4e
	call        copy_words
	ret

; 0C7D: Read ring with varying near-unity step; retain pointer/fraction between blocks.
read_modulated_delay:
	lr          $AC0.M, @MODULATED_DELAY_READ_OFFSET
	addi        $AC0.M, #MODULATED_DELAY_RING
	mrr         $AR3, $AC0.M
	clr         $ACC0
	clr         $ACC1
	lri         $AC1.M, #0x00a0
	lr          $AC0.M, @MODULATED_DELAY_READ_OFFSET
	sub         $ACC1, $ACC0
	lris        $AC0.M, #0x50
	cmpis       $AC1.M, #0x50
	ifge
	sub         $ACC1, $ACC0
	lr          $AX0.H, @MODULATED_DELAY_DIRECTION
	tstaxh      $AX0.H
	jge         loc_0cae
	lr          $AC0.M, @MODULATED_DELAY_THRESHOLD_0
	sub         $ACC0, $ACC1
	jle         loc_0c99
	jmp         loc_0cb3

loc_0c99:
	lr          $AX1.H, @MODULATED_DELAY_STEP_DELTA
	lri         $AC0.M, #0x8000
	addr        $ACC0, $AX1.H
	jmp         loc_0ca5

loc_0ca0:
	lr          $AX1.H, @MODULATED_DELAY_STEP_DELTA
	lri         $AC0.M, #0x8000
	subr        $ACC0, $AX1.H

loc_0ca5:
	sr          @MODULATED_DELAY_READ_STEP, $AC0.M
	mrr         $AC0.M, $AX0.H
	neg         $ACC0
	mrr         $AX0.H, $AC0.M
	sr          @MODULATED_DELAY_DIRECTION, $AC0.M
	jmp         loc_0cb3

loc_0cae:
	lr          $AC0.M, @MODULATED_DELAY_THRESHOLD_1
	sub         $ACC1, $ACC0
	jle         loc_0ca0

loc_0cb3:
	clr         $ACC1
	lr          $AC1.L, @MODULATED_DELAY_READ_STEP
	lsl         $ACC1, #1
	clr         $ACC0
	lr          $AC0.L, @MODULATED_DELAY_READ_FRACTION
	lri         $WR3, #0x009f
	lri         $AR0, #BUS_MODULATED_DELAY
	lris        $AX1.L, #0x00
	bloopi      #0x50, loc_0cc6
	lrr         $AX0.L, @$AR3
	add         $ACC0, $ACC1
	mrr         $IX3, $AC0.M
	addarn      $AR3, $IX3
	mrr         $AC0.M, $AX1.L

loc_0cc6:
	srri        @$AR0, $AX0.L
	lri         $AC1.M, #MODULATED_DELAY_RING
	mrr         $AC0.M, $AR3
	sub         $ACC0, $ACC1
	sr          @MODULATED_DELAY_READ_OFFSET, $AC0.M
	sr          @MODULATED_DELAY_READ_FRACTION, $AC0.L
	lri         $WR3, #0xffff
	ret

; 0CD2: Add processed 0A00 bus into both front buses with gain 3FFF (~1/2).
mix_modulated_delay:
	lris        $AC1.M, #0x50
	lri         $AR0, #BUS_MODULATED_DELAY
	lri         $AR3, #BUS_FRONT_RIGHT
	lri         $AX0.L, #0x3fff
	call        add_scaled_buffer
	lris        $AC1.M, #0x50
	lri         $AR0, #BUS_MODULATED_DELAY
	lri         $AR3, #BUS_FRONT_LEFT
	lri         $AX0.L, #0x3fff
	call        add_scaled_buffer
	ret

; 0CE5: Distance filter: y[n] = y[n-1] + k*(x[n]-x[n-1])/128, with saturation.
filter_distance:
	m2
	set40
	clr         $ACC0
	lr          $AC0.M, @VOICE_RESET
	tst         $ACC0
	jz          loc_0cf2
	clr         $ACC0
	sr          @VOICE_DISTANCE_HISTORY_Y, $AC0.M
	sr          @VOICE_DISTANCE_HISTORY_X, $AC0.M

loc_0cf2:
	lr          $AC1.M, @VOICE_DISTANCE_HISTORY_X
	lr          $AX1.H, @VOICE_DISTANCE_HISTORY_Y
	lris        $AX1.L, #0x00
	lri         $IX0, #0x0000
	bloopi      #0x50, loc_0d02
	lrrn        $AC0.M, @$AR0
	sub'ln      $ACC0, $ACC1 : $AC1.M, @$AR0
	mulc        $AC0.M, $AX0.H
	movp        $ACC0
	asl         $ACC0, #8
	addax       $ACC0, $AX1
	srri        @$AR0, $AC0.M

loc_0d02:
	mrr         $AX1.H, $AC0.M
	sr          @VOICE_DISTANCE_HISTORY_Y, $AX1.H
	sr          @VOICE_DISTANCE_HISTORY_X, $AC1.M
	m0
	set16
	ret

; 0D0A: Mix 80 samples: first 32 pairs ramp volume, last 8 pairs hold volume.
mix_buffer_with_gain_ramp:
	tst         $ACC1
	jnz         loc_0d10
	movax       $ACC0, $AX0
	tst         $ACC0
	retz

loc_0d10:
	mrr         $AR1, $AR3
	lrri        $AC0.M, @$AR3
	lrri        $AX1.H, @$AR0
	mulc'l      $AC1.M, $AX1.H : $AX1.H, @$AR0
	bloopi      #0x20, loc_0d1a
	mulcac'ldax $AC1.M, $AX1.H, $ACC0 : $AX1, @$AR0
	movr's      $ACC0, $AX1.L : @$AR1, $AC0.M
	mulcac'ldax $AC1.M, $AX1.H, $ACC0 : $AX1, @$AR0
	movr's      $ACC0, $AX1.L : @$AR1, $AC0.M

loc_0d1a:
	addax       $ACC1, $AX0
	bloopi      #0x08, loc_0d20
	mulcac'ldax $AC1.M, $AX1.H, $ACC0 : $AX1, @$AR0
	movr's      $ACC0, $AX1.L : @$AR1, $AC0.M
	mulcac'ldax $AC1.M, $AX1.H, $ACC0 : $AX1, @$AR0

loc_0d20:
	movr's      $ACC0, $AX1.L : @$AR1, $AC0.M
	ret

; 0D22: Master Q4.12 gain, saturate to signed PCM16.
apply_master_gain:
	set40
	mrr         $AR0, $AR3
	lr          $AX1.H, @MASTER_GAIN
	lris        $AX0.H, #0x04
	lrri        $AX0.L, @$AR3
	mulx'l      $AX0.L, $AX1.H : $AX0.L, @$AR3
	mulxmv      $AX0.L, $AX1.H, $ACC0
	bloopi      #0x28, loc_0d2f
	asrnrx'l    $ACC0, $AX0.H : $AX0.L, @$AR3
	mulxmv's    $AX0.L, $AX1.H, $ACC0 : @$AR0, $AC0.M
	asrnrx'l    $ACC0, $AX0.H : $AX0.L, @$AR3

loc_0d2f:
	mulxmv's    $AX0.L, $AX1.H, $ACC0 : @$AR0, $AC0.M
	set16
	ret

; 0D32: Automatic positional/Dolby mixer: 4 dry and 4 effects destinations.
mix_positional_voice:
	lr          $AX0.H, @VOICE_STOP_REQUESTED
	tstaxh      $AX0.H
	jz          loc_0d44
	clr         $ACC0
	lr          $AC0.M, @VOICE_POSITIONAL_GAIN_CURRENT
	lsr         $ACC0, #-1
	sr          @VOICE_POSITIONAL_GAIN_TARGET, $AC0.M
	tst         $ACC0
	jnz         loc_0d44
	lri         $AX0.H, #0x0001
	sr          @VOICE_DONE, $AX0.H

loc_0d44:
	set40
	clr         $ACC0
	lr          $AC0.M, @VOICE_POSITION
	lsr         $ACC0, #-8
	lr          $AC1.M, @VOICE_POSITION
	andi        $AC1.M, #0x007f
	mrr         $AX0.L, $AC0.M
	mrr         $AX0.H, $AC1.M
	xori        $AC0.M, #0x007f
	mrr         $AX1.L, $AC0.M
	xori        $AC1.M, #0x007f
	mrr         $AX1.H, $AC1.M
	clr         $ACC0
	clr         $ACC1
	lri         $AC1.M, #POSITIONAL_SINE_TABLE
	mrr         $AC0.M, $AX0.L
	add         $ACC0, $ACC1
	mrr         $AR0, $AC0.M
	lrr         $AX0.L, @$AR0
	mrr         $AC0.M, $AX0.H
	add         $ACC0, $ACC1
	mrr         $AR0, $AC0.M
	lrr         $AX0.H, @$AR0
	mrr         $AC0.M, $AX1.L
	add         $ACC0, $ACC1
	mrr         $AR0, $AC0.M
	lrr         $AX1.L, @$AR0
	mrr         $AC0.M, $AX1.H
	add         $ACC0, $ACC1
	mrr         $AR0, $AC0.M
	lrr         $AX1.H, @$AR0
	lri         $AR0, #SHARED_SAMPLE_GAIN_SCRATCH
	mul         $AX1.L, $AX1.H
	mulxmv      $AX0.L, $AX1.H, $ACC0
	mulxmv's    $AX0.H, $AX1.L, $ACC0 : @$AR0, $AC0.M
	mulmv's     $AX0.L, $AX0.H, $ACC0 : @$AR0, $AC0.M
	movp's      $ACC0 : @$AR0, $AC0.M
	srri        @$AR0, $AC0.M
	lri         $AR0, #SHARED_SAMPLE_GAIN_SCRATCH
	lri         $AR1, #0x0b04
	lr          $AX0.H, @VOICE_POSITIONAL_GAIN_CURRENT
	call        scale_gain_vector
	lri         $AR1, #0x0b08
	lri         $AR0, #0x0b04
	lr          $AX0.H, @VOICE_POSITIONAL_GAIN_CURRENT
	lr          $AC0.M, @VOICE_EFFECTS_GAIN
	mulc        $AC0.M, $AX0.H
	movp        $ACC0
	asl         $ACC0, #1
	mrr         $AX0.H, $AC0.M
	call        scale_gain_vector
	lri         $AR0, #SHARED_SAMPLE_GAIN_SCRATCH
	lri         $AR1, #0x0b0c
	clr         $ACC0
	clr         $ACC1
	lr          $AC0.M, @VOICE_POSITIONAL_GAIN_TARGET
	lr          $AC1.M, @VOICE_POSITIONAL_GAIN_CURRENT
	sr          @VOICE_POSITIONAL_GAIN_CURRENT, $AC0.M
	sub         $ACC0, $ACC1
	mrr         $AX0.H, $AC0.M
	call        scale_gain_delta_vector
	lri         $AR0, #0x0b0c
	lri         $AR1, #0x0b10
	lr          $AX0.H, @VOICE_EFFECTS_GAIN
	call        scale_gain_vector
	lri         $AR1, #0x0b04
	lri         $AR2, #0x0b0c
	lri         $AR3, #positional_destination_table
	bloopi      #0x08, loc_0dbe
	lrri        $AC1.M, @$AR2
	asr         $ACC1, #-5
	mrr         $AX0.L, $AC1.L
	mrr         $AX0.H, $AC1.M
	lrri        $AC1.M, @$AR1
	sr          @POSITIONAL_SAVED_AR1, $AR1
	sr          @POSITIONAL_SAVED_AR2, $AR2
	ilrri       $AC0.M, @$AR3
	sr          @POSITIONAL_SAVED_AR3, $AR3
	mrr         $AR3, $AC0.M
	lr          $AR0, @FILTERED_VOICE_POINTER
	call        mix_buffer_with_gain_ramp
	lr          $AR1, @POSITIONAL_SAVED_AR1
	lr          $AR2, @POSITIONAL_SAVED_AR2
	lr          $AR3, @POSITIONAL_SAVED_AR3

loc_0dbe:
	nop
	set16
	ret

; 0DC1: Multiply a four-element gain vector.
scale_gain_vector:
	lrri        $AC1.M, @$AR0
	mulc'l      $AC1.M, $AX0.H : $AC1.M, @$AR0
	mulcmv'l    $AC1.M, $AX0.H, $ACC0 : $AC1.M, @$AR0
	mulcmv's    $AC1.M, $AX0.H, $ACC0 : @$AR1, $AC0.M
	lrri        $AC1.M, @$AR0
	mulcmv's    $AC1.M, $AX0.H, $ACC0 : @$AR1, $AC0.M
	movp's      $ACC0 : @$AR1, $AC0.M
	srri        @$AR1, $AC0.M
	ret

; 0DCA: Multiply a four-element gain-difference vector with unsigned handling.
scale_gain_delta_vector:
	set15
	mrr         $AX1.H, $AC0.M
	lrri        $AX0.L, @$AR0
	mulx'l      $AX0.L, $AX1.H : $AX0.L, @$AR0
	mulxmv'l    $AX0.L, $AX1.H, $ACC0 : $AX0.L, @$AR0
	mulxmv's    $AX0.L, $AX1.H, $ACC0 : @$AR1, $AC0.M
	lrri        $AX0.L, @$AR0
	mulxmv's    $AX0.L, $AX1.H, $ACC0 : @$AR1, $AC0.M
	movp's      $ACC0 : @$AR1, $AC0.M
	srri        @$AR1, $AC0.M
	clr15
	ret

; 0DD6: DATA: eight DRAM destination addresses for positional mixing.
positional_destination_table:
	cw BUS_FRONT_LEFT
	cw BUS_FRONT_RIGHT
	cw BUS_REAR_LEFT
	cw BUS_REAR_RIGHT
	cw BUS_FRONT_LEFT_FX
	cw BUS_FRONT_RIGHT_FX
	cw BUS_REAR_LEFT_FX
	cw BUS_REAR_RIGHT_FX

; 0DDE: Common resampler: prepend four saved raw history samples.
resample:
	sr          @DATA_0361, $AX1.L
	mrr         $AC0.M, $AR0
	addi        $AC0.M, #0xfffc
	mrr         $AR0, $AC0.M
	mrr         $AR2, $AC0.M
	lri         $AR3, #VOICE_RESAMPLING_HISTORY
	lrri        $AC0.M, @$AR3
	lrri        $AC1.M, @$AR3
	nx'sl       : $AC0.M, $AX0.H
	movr'sl     $ACC0, $AX0.H : $AC1.M, $AX0.H
	movr's      $ACC1, $AX0.H : @$AR0, $AC0.M
	srri        @$AR0, $AC1.M
	mrr         $AR0, $AR2
	clr         $ACC0
	lr          $AC0.M, @VOICE_PITCH
	sr          @DATA_0362, $AC0.M
	lsr         $ACC0, #-12
	mrr         $AX1.H, $AC0.M
	mrr         $AX1.L, $AC0.L
	clr         $ACC1
	lr          $AC1.L, @VOICE_PHASE_FRACTION
	lsl         $ACC1, #4

; 0DFA: Pitch >= 4.0 branches to simple sample selection.
	cmpis       $AC0.M, #0x04
	jge         resample_without_interpolation

; 0DFD: Build 80 phase/coeff selections from 64 phases * 4 taps.
	mrr         $AC0.M, $AC1.L
	lri         $AR2, #RESAMPLER_PHASE_SCRATCH
	loopi       #0x50
	addax's     $ACC1, $AX1 : @$AR2, $AC1.L
	mrr         $AC1.L, $AC0.M
	sr          @DATA_0360, $AC0.M
	clr         $ACC1
	mrr         $AC1.L, $AC0.M
	lris        $AX0.H, #0xf8
	lri         $AX1.H, #0x00fc
	lr          $AX0.L, @DATA_0361
	lri         $AR2, #RESAMPLER_PHASE_SCRATCH
	lri         $AR3, #RESAMPLER_PHASE_SCRATCH
	lrri        $AC0.M, @$AR2
	lsrnrx      $ACC0, $AX0.H
	bloopi      #0x28, loc_0e17
	andr'l      $AC0.M, $AX1.H : $AC1.M, @$AR2
	lsrnrx's    $ACC1, $AX0.H : @$AR3, $AC0.M
	andr'l      $AC1.M, $AX1.H : $AC0.M, @$AR2

loc_0e17:
	lsrnrx's    $ACC0, $AX0.H : @$AR3, $AC1.M
	m2
	lri         $AR2, #RESAMPLER_PHASE_SCRATCH
	lr          $AC1.L, @VOICE_PHASE_FRACTION
	lsl         $ACC1, #4
	mrr         $AC1.M, $AR0
	clr         $ACC0
	lr          $AC0.M, @DATA_0362
	lsr         $ACC0, #-12
	mrr         $AX1.H, $AC0.M
	mrr         $AX1.L, $AC0.L

; 0E25: Four-tap fixed-point FIR interpolation using coefficient table at 0000.
	set40
	lrri        $AR3, @$AR2
	addax'ldax  $ACC1, $AX1 : $AX0, @$AR0
	mul'ldax    $AX0.L, $AX0.H : $AX0, @$AR0
	madd'ldax   $AX0.L, $AX0.H : $AX0, @$AR0
	madd'ldax   $AX0.L, $AX0.H : $AX0, @$AR0
	madd        $AX0.L, $AX0.H
	movpz       $ACC0
	mrr         $AR0, $AC1.M
	lrri        $AR3, @$AR2
	addax'ldax  $ACC1, $AX1 : $AX0, @$AR0
	mul'ldax    $AX0.L, $AX0.H : $AX0, @$AR0
	bloopi      #0x4e, loc_0e39
	madd'ldax   $AX0.L, $AX0.H : $AX0, @$AR0
	madd'ldax   $AX0.L, $AX0.H : $AX0, @$AR0
	madd's      $AX0.L, $AX0.H : @$AR1, $AC0.M
	mrr         $AR0, $AC1.M
	lrri        $AR3, @$AR2
	addax'ldax  $ACC1, $AX1 : $AX0, @$AR0

loc_0e39:
	mulmvz'ldax $AX0.L, $AX0.H, $ACC0 : $AX0, @$AR0
	madd'ldax   $AX0.L, $AX0.H : $AX0, @$AR0
	madd'ldax   $AX0.L, $AX0.H : $AX0, @$AR0
	madd's      $AX0.L, $AX0.H : @$AR1, $AC0.M
	movpz       $ACC0
	srri        @$AR1, $AC0.M
	m0
	set16

; 0E41: Save last output sample, fractional phase, and four raw history samples.
save_resampler_state:
	sr          @VOICE_CONSTANT_SAMPLE, $AC0.M
	mrr         $AR0, $AC1.M
	lsl         $ACC1, #12
	andi        $AC1.M, #0x0fff
	sr          @VOICE_PHASE_FRACTION, $AC1.M
	lri         $AR3, #VOICE_RESAMPLING_HISTORY
	lrri        $AC0.M, @$AR0
	lrri        $AC1.M, @$AR0
	nx'ls       : $AX0.H, $AC0.M
	movr'ls     $ACC0, $AX0.H : $AX0.H, $AC1.M
	movr's      $ACC1, $AX0.H : @$AR3, $AC0.M
	srri        @$AR3, $AC1.M
	ret

; 0E52: Pitch >= 4: no FIR interpolation.
resample_without_interpolation:
	mrr         $AC1.M, $AR0
	mrr         $AR0, $AC1.M
	bloopi      #0x28, loc_0e5b
	addax'l     $ACC1, $AX1 : $AC0.M, @$AR0
	srri        @$AR1, $AC0.M
	mrr         $AR0, $AC1.M
	addax'l     $ACC1, $AX1 : $AC0.M, @$AR0
	srri        @$AR1, $AC0.M

loc_0e5b:
	mrr         $AR0, $AC1.M
	jmp         save_resampler_state

; 0E5E: Constant/paused voice: fill 80 samples from saved constant, continue at filters.
load_constant_voice:
	lri         $AR3, #VOICE_SAMPLE_BUFFER
	lr          $AC0.M, @VOICE_CONSTANT_SAMPLE
	loopi       #0x50
	srri        @$AR3, $AC0.M
	jmp         filter_voice

; 0E66: Padding to DMA-aligned 0x1CE0-byte blob end.
ucode_padding:
	nop
	nop
	nop
	nop
	nop
	nop
	nop
	nop
	nop
	nop
