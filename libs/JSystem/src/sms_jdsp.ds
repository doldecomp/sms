reset_pcm16_position:
	clr         $ACC0
	srs         @VOICE_SOURCE_POSITION_H_SHORT, $AC0.M
	srs         @VOICE_SOURCE_POSITION_L_SHORT, $AC0.M

compute_pcm16_position:
	lrs         $AX1.H, @VOICE_SOURCE_POSITION_H_SHORT
	lrs         $AX1.L, @VOICE_SOURCE_POSITION_L_SHORT
	lrs         $AC0.M, @VOICE_LOOP_END_POSITION_H_SHORT
	lrs         $AC0.L, @VOICE_LOOP_END_POSITION_L_SHORT
	subax       $ACC0, $AX1
	srs         @VOICE_REMAINING_LENGTH_H_SHORT, $AC0.M
	srs         @VOICE_REMAINING_LENGTH_L_SHORT, $AC0.L
	lrs         $AC0.M, @VOICE_SOURCE_POSITION_H_SHORT
	lrs         $AC0.L, @VOICE_SOURCE_POSITION_L_SHORT
	lsl         $ACC0, #1
